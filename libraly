
local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local DEFAULTS = {
    Background = Color3.fromRGB(0, 0, 0),
    Surface = Color3.fromRGB(8, 8, 8),
    Row = Color3.fromRGB(15, 15, 15),
    Hover = Color3.fromRGB(32, 32, 32),
    Border = Color3.fromRGB(65, 65, 65),
    Text = Color3.fromRGB(255, 255, 255),
    Muted = Color3.fromRGB(165, 165, 165),
    Accent = Color3.fromRGB(255, 255, 255)
}

local function create(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties or {}) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 5)
    }, object)
end

local function stroke(object, color, thickness)
    object.BorderSizePixel = 0

    create("UIStroke", {
        Color = color,
        Thickness = thickness or 1
    }, object)
end

local function makeLabel(parent, text, size, color)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = color or Color3.new(1, 1, 1),
        TextSize = size or 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function normalizeKey(value)
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
        return value
    end

    if type(value) == "string" then
        return Enum.KeyCode[value] or Enum.KeyCode.Unknown
    end

    return Enum.KeyCode.Unknown
end

function Library:CreateWindow(title, options)
    options = options or {}

    local player = Players.LocalPlayer
    assert(player, "CreateWindow must be called from the client")

    local playerGui = player:WaitForChild("PlayerGui")
    local theme = {}

    for name, default in pairs(DEFAULTS) do
        theme[name] = options[name] or default
    end

    local self = setmetatable({
        Categories = {},
        Connections = {},
        CleanupCallbacks = {},
        ToggleControls = {},
        Theme = theme,
        CurrentCategory = nil,
        CategoryIndex = 0,
        Search = "",
        Destroyed = false
    }, Library)

    local C = theme

    function self:Connect(signal, callback)
        if self.Destroyed then
            return nil
        end

        local connection = signal:Connect(callback)
        table.insert(self.Connections, connection)
        return connection
    end

    function self:BindCleanup(callback)
        if type(callback) == "function" then
            table.insert(self.CleanupCallbacks, callback)
        end
    end

    local gui = create("ScreenGui", {
        Name = "IRONWALL_UI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 9999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, playerGui)

    self.Gui = gui

    local window = create("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(980, 600),
        BackgroundColor3 = C.Background,
        BackgroundTransparency = math.clamp(
            tonumber(options.Transparency) or 0.08, 0, 0.9
        ),
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, gui)

    round(window, 8)
    stroke(window, C.Border)
    self.Window = window

    local topbar = create("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = C.Surface,
        BorderSizePixel = 0
    }, window)

    local heading = makeLabel(topbar, title or "IRONWALL", 13, C.Text)
    heading.Position = UDim2.fromOffset(14, 0)
    heading.Size = UDim2.new(1, -110, 1, 0)

    local close = create("TextButton", {
        Position = UDim2.new(1, -36, 0, 6),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = C.Row,
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = C.Text,
        TextSize = 22,
        Font = Enum.Font.Gotham,
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, topbar)
    round(close, 5)

    local minimize = create("TextButton", {
        Position = UDim2.new(1, -68, 0, 6),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = C.Row,
        BackgroundTransparency = 1,
        Text = "−",
        TextColor3 = C.Text,
        TextSize = 20,
        Font = Enum.Font.Gotham,
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, topbar)
    round(minimize, 5)

    local searchFrame = create("Frame", {
        Position = UDim2.fromOffset(8, 48),
        Size = UDim2.new(1, -16, 0, 38),
        BackgroundColor3 = C.Surface,
        BorderSizePixel = 0
    }, window)
    round(searchFrame, 5)
    stroke(searchFrame, C.Border)

    local searchBox = create("TextBox", {
        Position = UDim2.fromOffset(7, 4),
        Size = UDim2.new(1, -14, 1, -8),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "SEARCH FUNCTIONS...",
        PlaceholderColor3 = C.Muted,
        TextColor3 = C.Text,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
        BorderSizePixel = 0
    }, searchFrame)

    local grid = create("ScrollingFrame", {
        Name = "Categories",
        Position = UDim2.fromOffset(8, 94),
        Size = UDim2.new(1, -16, 1, -102),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.Border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y
    }, window)

    local gridLayout = create("UIGridLayout", {
        CellSize = UDim2.fromOffset(300, 290),
        CellPadding = UDim2.fromOffset(7, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top
    }, grid)

    local resize = create("TextButton", {
        Name = "ResizeHandle",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.fromOffset(17, 17),
        BackgroundColor3 = C.Surface,
        Text = "◢",
        TextColor3 = C.Muted,
        TextSize = 11,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = 5
    }, window)

    local restore = create("TextButton", {
        Name = "Restore",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(35, 200),
        Size = UDim2.fromOffset(44, 44),
        BackgroundColor3 = C.Surface,
        Text = title or "UI",
        TextColor3 = C.Text,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 10
    }, gui)
    round(restore, 8)
    stroke(restore, C.Border)

    local minimized = false
    local dragging = false
    local resizing = false
    local dragInput
    local dragStart
    local startPosition
    local resizeStart
    local startSize

    local function updateGrid()
        if self.Destroyed then
            return
        end

        local width = grid.AbsoluteSize.X
        if width <= 0 then
            return
        end

        local columns = width >= 900 and 3 or (width >= 570 and 2 or 1)
        local gap = 7
        local cellWidth = math.max(
            180,
            math.floor((width - gap * (columns - 1)) / columns)
        )

        gridLayout.CellSize = UDim2.fromOffset(cellWidth, 290)
        gridLayout.FillDirectionMaxCells = columns
    end

    local function refreshSearch()
        if self.Destroyed then
            return
        end

        local query = string.lower(self.Search)

        for _, category in ipairs(self.Categories) do
            local found = false

            for _, item in ipairs(category.Items) do
                local searchable = string.lower(
                    item.Name .. " " .. tostring(item.Description or "")
                )

                local matches = query == ""
                    or string.find(searchable, query, 1, true) ~= nil

                item.Frame.Visible = matches
                found = found or matches
            end

            category.Frame.Visible = query == "" or found
        end

        updateGrid()
    end

    self:Connect(searchBox:GetPropertyChangedSignal("Text"), function()
        self.Search = searchBox.Text
        refreshSearch()
    end)

    local function sortCategories()
        table.sort(self.Categories, function(a, b)
            if a.Order == b.Order then
                return a.Id < b.Id
            end
            return a.Order < b.Order
        end)

        for index, category in ipairs(self.Categories) do
            category.Frame.LayoutOrder = index
        end

        updateGrid()
    end

    function self:Category(name, order)
        if self.Destroyed then
            return nil
        end

        self.CategoryIndex += 1

        local id = self.CategoryIndex
        local categoryName = tostring(name or ("CATEGORY " .. id))

        local frame = create("Frame", {
            Name = categoryName,
            BackgroundColor3 = C.Surface,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            LayoutOrder = tonumber(order) or id
        }, grid)

        round(frame, 6)
        stroke(frame, C.Border)

        local header = create("TextButton", {
            Position = UDim2.fromOffset(4, 4),
            Size = UDim2.new(1, -8, 0, 30),
            BackgroundColor3 = C.Row,
            Text = "",
            BorderSizePixel = 0,
            AutoButtonColor = false
        }, frame)
        round(header, 5)

        local headerText = makeLabel(
            header, string.upper(categoryName), 10, C.Text
        )
        headerText.Position = UDim2.fromOffset(9, 0)
        headerText.Size = UDim2.new(1, -25, 1, 0)

        local collapseMark = makeLabel(header, "−", 12, C.Muted)
        collapseMark.AnchorPoint = Vector2.new(1, 0)
        collapseMark.Position = UDim2.new(1, -7, 0, 0)
        collapseMark.Size = UDim2.fromOffset(14, 30)
        collapseMark.TextXAlignment = Enum.TextXAlignment.Center

        local content = create("ScrollingFrame", {
            Name = "Items",
            Position = UDim2.fromOffset(4, 39),
            Size = UDim2.new(1, -8, 1, -43),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = C.Border,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y
        }, frame)

        local list = create("UIListLayout", {
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, content)

        local category = {
            Id = id,
            Name = categoryName,
            Order = tonumber(order) or id,
            Frame = frame,
            Header = header,
            Content = content,
            Items = {},
            Collapsed = false,
            Destroyed = false
        }

        local function newItem(itemName, height)
            local row = create("Frame", {
                Name = tostring(itemName),
                Size = UDim2.new(1, -2, 0, height),
                BackgroundColor3 = C.Row,
                BorderSizePixel = 0,
                LayoutOrder = #category.Items + 1
            }, content)
            round(row, 5)
            stroke(row, C.Border)

            local item = {
                Name = tostring(itemName),
                Frame = row,
                Description = ""
            }

            table.insert(category.Items, item)
            refreshSearch()

            return row, item
        end

        local function hover(row, button)
            self:Connect(button.MouseEnter, function()
                if row.Parent then
                    row.BackgroundColor3 = C.Hover
                end
            end)

            self:Connect(button.MouseLeave, function()
                if row.Parent then
                    row.BackgroundColor3 = C.Row
                end
            end)
        end

        function category:Button(name, description, callback)
            if type(description) == "function" then
                callback = description
                description = ""
            end

            local row, item = newItem(name, 32)
            item.Description = description or ""

            local button = create("TextButton", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Text = tostring(name),
                TextColor3 = C.Text,
                TextSize = 11,
                Font = Enum.Font.Gotham,
                BorderSizePixel = 0,
                AutoButtonColor = false
            }, row)

            hover(row, button)

            selfWindow = nil
            local connection = button.Activated:Connect(function()
                if not self.Destroyed and type(callback) == "function" then
                    task.spawn(function()
                        local ok, err = pcall(callback)
                        if not ok then
                            warn("[IRONWALL] Button error:", err)
                        end
                    end)
                end
            end)

            table.insert(LibraryConnections, connection)
            item.Button = button
            return button
        end

        function category:Toggle(name, description, callback)
            if type(description) == "function" then
                callback = description
                description = ""
            end

            local row, item = newItem(name, 32)
            item.Description = description or ""

            local caption = makeLabel(row, name, 11, C.Text)
            caption.Position = UDim2.fromOffset(9, 0)
            caption.Size = UDim2.new(1, -60, 1, 0)

            local switch = create("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -7, 0.5, 0),
                Size = UDim2.fromOffset(36, 18),
                BackgroundColor3 = C.Background,
                Text = "",
                BorderSizePixel = 0,
                AutoButtonColor = false
            }, row)
            round(switch, 9)
            stroke(switch, C.Border)

            local knob = create("Frame", {
                Position = UDim2.fromOffset(3, 3),
                Size = UDim2.fromOffset(12, 12),
                BackgroundColor3 = C.Text,
                BorderSizePixel = 0
            }, switch)
            round(knob, 8)

            local enabled = false
            local control = {}

            function control:Set(value, silent)
                if category.Destroyed then
                    return
                end

                enabled = value == true

                TweenService:Create(switch, TweenInfo.new(0.12), {
                    BackgroundColor3 = enabled and C.Accent or C.Background
                }):Play()

                TweenService:Create(knob, TweenInfo.new(0.12), {
                    Position = enabled and UDim2.new(1, -15, 0, 3)
                        or UDim2.fromOffset(3, 3),
                    BackgroundColor3 = enabled and C.Background or C.Text
                }):Play()

                if not silent and type(callback) == "function" then
                    task.spawn(function()
                        local ok, err = pcall(callback, enabled)
                        if not ok then
                            warn("[IRONWALL] Toggle error:", err)
                        end
                    end)
                end
            end

            function control:Get()
                return enabled
            end

            local connection = switch.Activated:Connect(function()
                control:Set(not enabled)
            end)

            table.insert(selfWindowConnections, connection)
            table.insert(windowToggleControls, control)

            item.Toggle = control
            return control
        end

        local function createKeybind(name, description, defaultKey, callback, withToggle, stateCallback)
            local row, item = newItem(name, 37)
            item.Description = description or ""

            local caption = makeLabel(row, name, 11, C.Text)
            caption.Position = UDim2.fromOffset(9, 0)
            caption.Size = UDim2.new(1, withToggle and -110 or -85, 1, 0)

            local key = normalizeKey(defaultKey)
            local enabled = not withToggle
            local waiting = false

            local keyButton = create("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -7, 0.5, 0),
                Size = UDim2.fromOffset(withToggle and 62 or 70, 24),
                BackgroundColor3 = C.Background,
                TextColor3 = C.Text,
                TextSize = 9,
                Font = Enum.Font.Gotham,
                BorderSizePixel = 0,
                AutoButtonColor = false
            }, row)
            round(keyButton, 4)
            stroke(keyButton, C.Border)

            local toggleButton

            if withToggle then
                toggleButton = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -74, 0.5, 0),
                    Size = UDim2.fromOffset(30, 24),
                    BackgroundColor3 = C.Background,
                    Text = "OFF",
                    TextColor3 = C.Text,
                    TextSize = 8,
                    Font = Enum.Font.Gotham,
                    BorderSizePixel = 0,
                    AutoButtonColor = false
                }, row)
                round(toggleButton, 4)
                stroke(toggleButton, C.Border)
            end

            local function refreshKeyText()
                keyButton.Text = waiting and "PRESS KEY"
                    or (key == Enum.KeyCode.Unknown and "NONE" or key.Name:upper())
            end

            refreshKeyText()

            local control = {}

            function control:SetKey(value)
                key = normalizeKey(value)
                waiting = false
                refreshKeyText()
            end

            function control:GetKey()
                return key
            end

            function control:Set(value, silent)
                enabled = value == true

                if toggleButton then
                    toggleButton.Text = enabled and "ON" or "OFF"
                    toggleButton.BackgroundColor3 = enabled and C.Text or C.Background
                    toggleButton.TextColor3 = enabled and C.Background or C.Text
                end

                if not silent and withToggle and type(stateCallback) == "function" then
                    task.spawn(stateCallback, enabled)
                end
            end

            function control:Get()
                return enabled
            end

            self:Connect(keyButton.Activated, function()
                waiting = true
                keyButton.Text = "PRESS KEY"
            end)

            if toggleButton then
                self:Connect(toggleButton.Activated, function()
                    control:Set(not enabled)
                end)
            end

            self:Connect(UIS.InputBegan, function(input, processed)
                if waiting then
                    if input.KeyCode == Enum.KeyCode.Escape then
                        key = Enum.KeyCode.Unknown
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                        key = input.KeyCode
                    end

                    waiting = false
                    refreshKeyText()
                    return
                end

                if processed or UIS:GetFocusedTextBox() then
                    return
                end

                if enabled and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
                    if type(callback) == "function" then
                        task.spawn(callback, control)
                    end
                end
            end)

            item.Keybind = control
            return control
        end

        function category:Keybind(name, description, defaultKey, callback)
            if normalizeKey(description) ~= Enum.KeyCode.Unknown then
                callback = defaultKey
                defaultKey = description
                description = ""
            elseif type(defaultKey) == "function" then
                callback = defaultKey
                defaultKey = Enum.KeyCode.Unknown
            end

            return createKeybind(name, description, defaultKey, callback, false)
        end

        function category:ToggleKeybind(name, description, defaultKey, callback, stateCallback)
            if normalizeKey(description) ~= Enum.KeyCode.Unknown then
                stateCallback = callback
                callback = defaultKey
                defaultKey = description
                description = ""
            end

            return createKeybind(name, description, defaultKey, callback, true, stateCallback)
        end

        function category:Slider(name, description, minimum, maximum, default, callback)
            minimum = tonumber(minimum) or 0
            maximum = tonumber(maximum) or 100

            if maximum < minimum then
                minimum, maximum = maximum, minimum
            end

            default = math.clamp(tonumber(default) or minimum, minimum, maximum)

            local row, item = newItem(name, 56)
            item.Description = description or ""

            local caption = makeLabel(row, name, 11, C.Text)
            caption.Position = UDim2.fromOffset(9, 1)
            caption.Size = UDim2.new(1, -50, 0, 21)

            local valueLabel = makeLabel(row, default, 10, C.Text)
            valueLabel.AnchorPoint = Vector2.new(1, 0)
            valueLabel.Position = UDim2.new(1, -9, 0, 1)
            valueLabel.Size = UDim2.fromOffset(40, 21)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local bar = create("TextButton", {
                Position = UDim2.new(0, 9, 0, 35),
                Size = UDim2.new(1, -18, 0, 7),
                BackgroundColor3 = C.Background,
                Text = "",
                BorderSizePixel = 0,
                AutoButtonColor = false
            }, row)
            round(bar, 4)
            stroke(bar, C.Border)

            local fill = create("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = C.Accent,
                BorderSizePixel = 0
            }, bar)
            round(fill, 4)

            local knob = create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.fromOffset(12, 14),
                BackgroundColor3 = C.Text,
                BorderSizePixel = 0
            }, bar)
            round(knob, 5)

            local value = default
            local sliding = false
            local control = {}

            local function setValue(newValue, fire)
                value = math.clamp(
                    math.floor(newValue + 0.5), minimum, maximum
                )

                local alpha = (value - minimum) / math.max(maximum - minimum, 1)

                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = tostring(value)

                if fire and type(callback) == "function" then
                    task.spawn(function()
                        local ok, err = pcall(callback, value)
                        if not ok then
                            warn("[IRONWALL] Slider error:", err)
                        end
                    end)
                end
            end

            local function updateFromInput(input)
                local alpha = math.clamp(
                    (input.Position.X - bar.AbsolutePosition.X)
                        / math.max(bar.AbsoluteSize.X, 1),
                    0, 1
                )

                setValue(minimum + (maximum - minimum) * alpha, true)
            end

            self:Connect(bar.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateFromInput(input)
                end
            end)

            self:Connect(UIS.InputChanged, function(input)
                if sliding and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    updateFromInput(input)
                end
            end)

            self:Connect(UIS.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            function control:Set(newValue)
                setValue(tonumber(newValue) or minimum, true)
            end

            function control:Get()
                return value
            end

            setValue(default, false)
            item.Slider = control
            return control
        end

        function category:SetOrder(newOrder)
            category.Order = tonumber(newOrder) or category.Order
            sortCategories()
        end

        function category:SetCollapsed(value)
            category.Collapsed = value == true
            content.Visible = not category.Collapsed
            collapseMark.Text = category.Collapsed and "+" or "−"
            content.Size = category.Collapsed
                and UDim2.new(1, -8, 0, 0)
                or UDim2.new(1, -8, 1, -43)
        end

        self:Connect(header.Activated, function()
            category:SetCollapsed(not category.Collapsed)
        end)

        table.insert(self.Categories, category)
        self.CurrentCategory = category
        sortCategories()

        return category
    end

    function self:Button(name, description, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Button(name, description, callback)
    end

    function self:Toggle(name, description, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Toggle(name, description, callback)
    end

    function self:Keybind(name, description, defaultKey, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Keybind(name, description, defaultKey, callback)
    end

    function self:ToggleKeybind(name, description, defaultKey, callback, stateCallback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:ToggleKeybind(
            name, description, defaultKey, callback, stateCallback
        )
    end

    function self:Slider(name, description, minimum, maximum, default, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Slider(
            name, description, minimum, maximum, default, callback
        )
    end

    function self:CategoryOrder(names)
        for order, name in ipairs(names) do
            for _, category in ipairs(self.Categories) do
                if string.lower(category.Name) == string.lower(name) then
                    category.Order = order
                end
            end
        end

        sortCategories()
    end

    local function hideWindow()
        if self.Destroyed or minimized then
            return
        end

        minimized = true
        window.Visible = false
        restore.Visible = true
    end

    local function showWindow()
        if self.Destroyed then
            return
        end

        minimized = false
        restore.Visible = false
        window.Visible = true
    end

    self:Connect(close.Activated, function()
        self:Destroy()
    end)

    self:Connect(minimize.Activated, hideWindow)
    self:Connect(restore.Activated, showWindow)

    self:Connect(topbar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = window.Position
        end
    end)

    self:Connect(resize.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            resizing = true
            resizeStart = input.Position
            startSize = window.AbsoluteSize
        end
    end)

    self:Connect(UIS.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if dragging and dragStart and startPosition then
            local delta = input.Position - dragStart
            window.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        elseif resizing and resizeStart and startSize then
            local delta = input.Position - resizeStart
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)

            local width = math.clamp(startSize.X + delta.X, 600, viewport.X)
            local height = math.clamp(startSize.Y + delta.Y, 400, viewport.Y)

            window.Size = UDim2.fromOffset(width, height)
            updateGrid()
        end
    end)

    self:Connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            resizing = false
        end
    end)

    self:Connect(grid:GetPropertyChangedSignal("AbsoluteSize"), updateGrid)
    self:Connect(window:GetPropertyChangedSignal("AbsoluteSize"), updateGrid)

    function self:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, control in ipairs(self.ToggleControls) do
            pcall(function()
                control:Set(false, true)
            end)
        end

        for _, callback in ipairs(self.CleanupCallbacks) do
            pcall(callback)
        end

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(self.Connections)
        table.clear(self.CleanupCallbacks)
        table.clear(self.ToggleControls)
        table.clear(self.Categories)

        if gui and gui.Parent then
            gui:Destroy()
        end
    end

    task.defer(function()
        if self.Destroyed then
            return
        end

        local camera = workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            window.Size = UDim2.fromOffset(
                math.min(980, viewport.X),
                math.min(600, viewport.Y)
            )
            window.Position = UDim2.fromScale(0.5, 0.5)
        end

        updateGrid()
    end)

    return self
end

return Library
