        local function createKeybind(name, description, defaultKey, callback, withToggle, stateCallback)
            local row, item = newItem(name, 37)
            item.Description = description or ""

            local caption = label(row, name, 11, C.Text)
            caption.Position = UDim2.fromOffset(9, 0)
            caption.Size = UDim2.new(1, withToggle and -110 or -85, 1, 0)

            local key = keyCode(defaultKey)
            local enabled = not withToggle
            local waiting = false

            local keyButton = make("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -7, 0.5, 0),
                Size = UDim2.fromOffset(withToggle and 62 or 70, 24),
                BackgroundColor3 = C.Background,
                BorderSizePixel = 0,
                Text = "",
                TextColor3 = C.Text,
                TextSize = 9,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false
            }, row)
            corner(keyButton, 4)
            outline(keyButton, C.Border, 1)

            local toggleButton
            if withToggle then
                toggleButton = make("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -74, 0.5, 0),
                    Size = UDim2.fromOffset(30, 24),
                    BackgroundColor3 = C.Background,
                    BorderSizePixel = 0,
                    Text = "OFF",
                    TextColor3 = C.Text,
                    TextSize = 8,
                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false
                }, row)
                corner(toggleButton, 4)
                outline(toggleButton, C.Border, 1)
            end

            local function refreshKeyText()
                keyButton.Text = waiting and "PRESS KEY"
                    or (key == Enum.KeyCode.Unknown and "NONE" or key.Name:upper())
            end
            refreshKeyText()

            local control = {}

            function control:SetKey(value)
                local newKey = keyCode(value)
                if newKey ~= Enum.KeyCode.Unknown or value == "Unknown" then
                    key = newKey
                    waiting = false
                    refreshKeyText()
                end
            end

            function control:GetKey()
                return key
            end

            function control:Set(value, silent)
                enabled = value == true

                if toggleButton then
                    toggleButton.Text = enabled and "ON" or "OFF"
                    toggleButton.BackgroundColor3 = enabled and C.Text or C.Background
                    toggleButton.TextColor3 = enabled and C.Background or C.Text
                end

                if not silent and withToggle and type(stateCallback) == "function" then
                    task.spawn(stateCallback, enabled)
                end
            end

            function control:Get()
                return enabled
            end

            local connection = keyButton.MouseButton1Click:Connect(function()
                waiting = true
                keyButton.Text = "PRESS KEY"
            end)
            table.insert(connectionsForItems, connection)

            if toggleButton then
                local toggleConnection = toggleButton.MouseButton1Click:Connect(function()
                    control:Set(not enabled)
                end)
                table.insert(connectionsForItems, toggleConnection)
            end

            local inputConnection = UIS.InputBegan:Connect(function(input, processed)
                if waiting then
                    if input.KeyCode == Enum.KeyCode.Escape then
                        key = Enum.KeyCode.Unknown
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                        key = input.KeyCode
                    end

                    waiting = false
                    refreshKeyText()
                    return
                end

                if processed or UIS:GetFocusedTextBox() then
                    return
                end

                if enabled and key ~= Enum.KeyCode.Unknown and input.KeyCode == key then
                    if type(callback) == "function" then
                        task.spawn(callback, control)
                    end
                end
            end)
            table.insert(connectionsForItems, inputConnection)

            item.Keybind = control
            return control
        end

        function category:Keybind(name, description, defaultKey, callback)
            if keyCode(description) ~= Enum.KeyCode.Unknown then
                callback = defaultKey
                defaultKey = description
                description = nil
            elseif type(defaultKey) == "function" then
                callback = defaultKey
                defaultKey = Enum.KeyCode.Unknown
            end

            return createKeybind(name, description, defaultKey, callback, false)
        end

        function category:ToggleKeybind(name, description, defaultKey, callback, stateCallback)
            if keyCode(description) ~= Enum.KeyCode.Unknown then
                stateCallback = callback
                callback = defaultKey
                defaultKey = description
                description = nil
            end

            return createKeybind(name, description, defaultKey, callback, true, stateCallback)
        end

        function category:Slider(name, description, minimum, maximum, default, callback)
            minimum = tonumber(minimum) or 0
            maximum = tonumber(maximum) or 100
            if maximum < minimum then
                minimum, maximum = maximum, minimum
            end

            default = math.clamp(tonumber(default) or minimum, minimum, maximum)

            local row, item = newItem(name, 56)
            item.Description = description or ""

            local caption = label(row, name, 11, C.Text)
            caption.Position = UDim2.fromOffset(9, 1)
            caption.Size = UDim2.new(1, -50, 0, 21)

            local valueLabel = label(row, default, 10, C.Text)
            valueLabel.AnchorPoint = Vector2.new(1, 0)
            valueLabel.Position = UDim2.new(1, -9, 0, 1)
            valueLabel.Size = UDim2.fromOffset(40, 21)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local bar = make("TextButton", {
                Position = UDim2.new(0, 9, 0, 35),
                Size = UDim2.new(1, -18, 0, 7),
                BackgroundColor3 = C.Background,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, row)
            corner(bar, 4)
            outline(bar, C.Border, 1)

            local fill = make("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = C.Accent,
                BorderSizePixel = 0
            }, bar)
            corner(fill, 4)

            local knob = make("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.fromOffset(12, 14),
                BackgroundColor3 = C.Text,
                BorderSizePixel = 0
            }, bar)
            corner(knob, 5)

            local value = default
            local sliding = false
            local control = {}

            local function setValue(newValue, fire)
                value = math.clamp(math.floor(newValue + 0.5), minimum, maximum)
                local alpha = (value - minimum) / math.max(maximum - minimum, 1)

                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = tostring(value)

                if fire and type(callback) == "function" then
                    task.spawn(callback, value)
                end
            end

            local function updateFromInput(input)
                local alpha = math.clamp(
                    (input.Position.X - bar.AbsolutePosition.X)
                        / math.max(bar.AbsoluteSize.X, 1),
                    0,
                    1
                )
                setValue(minimum + (maximum - minimum) * alpha, true)
            end

            local beginConnection = bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateFromInput(input)
                end
            end)
            table.insert(connectionsForItems, beginConnection)

            local changeConnection = UIS.InputChanged:Connect(function(input)
                if sliding and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    updateFromInput(input)
                end
            end)
            table.insert(connectionsForItems, changeConnection)

            local endConnection = UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            table.insert(connectionsForItems, endConnection)

            function control:Set(newValue)
                setValue(tonumber(newValue) or minimum, true)
            end

            function control:Get()
                return value
            end

            setValue(default, false)
            item.Slider = control
            return control
        end

        function category:SetOrder(newOrder)
            category.Order = tonumber(newOrder) or category.Order
            sortCategories()
        end

        function category:SetCollapsed(value)
            category.Collapsed = value == true
            content.Visible = not category.Collapsed
            collapseMark.Text = category.Collapsed and "+" or "−"
            content.Size = category.Collapsed
                and UDim2.new(1, -8, 0, 0)
                or UDim2.new(1, -8, 1, -43)
            frame.BackgroundTransparency = category.Collapsed and 1 or 0.05
            updateGrid()
        end

        self:Connect(header.MouseButton1Click, function()
            if not categoryDragMoved then
                category:SetCollapsed(not category.Collapsed)
            end
        end)

        self:Connect(header.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                categoryDrag = category
                categoryDragOrigin = input.Position
                categoryDragMoved = false
            end
        end)

        table.insert(self.Categories, category)
        self.CurrentCategory = category
        sortCategories()
        refreshSearch()

        task.defer(function()
            if not self.Destroyed then
                updateContent()
                updateGrid()
            end
        end)

        return category
    end

    function self:Button(name, description, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Button(name, description, callback)
    end

    function self:Toggle(name, description, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Toggle(name, description, callback)
    end

    function self:Keybind(name, description, defaultKey, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Keybind(name, description, defaultKey, callback)
    end

    function self:ToggleKeybind(name, description, defaultKey, callback, stateCallback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:ToggleKeybind(
            name, description, defaultKey, callback, stateCallback
        )
    end

    function self:Slider(name, description, minimum, maximum, default, callback)
        if not self.CurrentCategory then
            self:Category("GENERAL")
        end
        return self.CurrentCategory:Slider(
            name, description, minimum, maximum, default, callback
        )
    end

    function self:CategoryOrder(names)
        for order, name in ipairs(names) do
            for _, category in ipairs(self.Categories) do
                if string.lower(category.Name) == string.lower(name) then
                    category.Order = order
                end
            end
        end
        sortCategories()
    end

    self:Connect(collapseButton.MouseButton1Click, function()
        collapseAll(true)
    end)

    self:Connect(expandButton.MouseButton1Click, function()
        collapseAll(false)
    end)

    self:Connect(topButton.MouseButton1Click, function()
        grid.CanvasPosition = Vector2.zero
    end)

    local function hideWindow()
        if self.Destroyed or minimized then
            return
        end

        windowPosition = window.Position
        windowSize = window.Size

        restore.Position = UDim2.fromOffset(
            window.AbsolutePosition.X + window.AbsoluteSize.X - 25,
            window.AbsolutePosition.Y + 25
        )

        minimized = true
        window.Visible = false
        restore.Visible = true
    end

    local function showWindow()
        if self.Destroyed then
            return
        end

        minimized = false
        restore.Visible = false
        window.Visible = true
        window.Position = windowPosition
        window.Size = windowSize
    end

    self:Connect(restore.MouseButton1Click, showWindow)
    self:Connect(minimizeButton.MouseButton1Click, hideWindow)

    self:Connect(close.MouseButton1Click, function()
        self:Destroy()
    end)

    self:Connect(UIS.InputBegan, function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.LeftAlt then
            if minimized then
                showWindow()
            else
                hideWindow()
            end
        end
    end)

    self:Connect(topbar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = window
            dragOrigin = input.Position
            dragPosition = window.Position
        end
    end)

    self:Connect(restore.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = restore
            dragOrigin = input.Position
            dragPosition = restore.Position
        end
    end)

    self:Connect(resize.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            resizeOrigin = input.Position
            resizeSize = window.AbsoluteSize
            resizePosition = window.Position
        end
    end)

    self:Connect(UIS.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        if categoryDrag and categoryDragOrigin then
            local delta = input.Position - categoryDragOrigin
            if delta.Magnitude >= 10 then
                categoryDragMoved = true
            end
        end

        if dragging and dragOrigin then
            local delta = input.Position - dragOrigin
            local pos = UDim2.fromOffset(
                dragPosition.X.Offset + delta.X,
                dragPosition.Y.Offset + delta.Y
            )
            dragging.Position = pos

            if dragging == window then
                windowPosition = pos
            else
                restorePosition = pos
            end
        end

        if resizing and resizeOrigin then
            local delta = input.Position - resizeOrigin
            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
            local width = math.clamp(resizeSize.X + delta.X, 600, math.max(600, viewport.X))
            local height = math.clamp(resizeSize.Y + delta.Y, 400, math.max(400, viewport.Y))

            window.Size = UDim2.fromOffset(width, height)
            window.Position = resizePosition
            windowPosition = resizePosition
            windowSize = window.Size
            updateGrid()
        end
    end)

    self:Connect(UIS.InputEnded, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        dragging = nil
        resizing = false

        if categoryDrag then
            local dragged = categoryDrag
            categoryDrag = nil

            if categoryDragMoved then
                local nearest, nearestDistance

                for _, other in ipairs(self.Categories) do
                    if other ~= dragged and other.Frame.Visible then
                        local center = other.Frame.AbsolutePosition
                            + other.Frame.AbsoluteSize / 2
                        local distance = (center - input.Position).Magnitude

                        if not nearestDistance or distance < nearestDistance then
                            nearest = other
                            nearestDistance = distance
                        end
                    end
                end

                if nearest and nearestDistance and nearestDistance < 180 then
                    dragged.Order, nearest.Order = nearest.Order, dragged.Order
                    sortCategories()
                end
            end

            task.defer(function()
                categoryDragMoved = false
            end)
        end
    end)

    self:Connect(grid:GetPropertyChangedSignal("AbsoluteSize"), updateGrid)
    self:Connect(window:GetPropertyChangedSignal("AbsoluteSize"), updateGrid)

    self:Connect(minimizeButton.MouseEnter, function()
        minimizeButton.BackgroundTransparency = 0.15
    end)
    self:Connect(minimizeButton.MouseLeave, function()
        minimizeButton.BackgroundTransparency = 1
    end)
    self:Connect(close.MouseEnter, function()
        close.BackgroundTransparency = 0.1
        close.BackgroundColor3 = C.Hover
    end)
    self:Connect(close.MouseLeave, function()
        close.BackgroundTransparency = 1
        close.BackgroundColor3 = C.Row
    end)

    function self:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, control in ipairs(self.ToggleControls) do
            pcall(function()
                control:Set(false, true)
            end)
        end

        for _, callback in ipairs(self.CleanupCallbacks) do
            pcall(callback)
        end

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        for _, connection in ipairs(connectionsForItems) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(self.Connections)
        table.clear(self.CleanupCallbacks)
        table.clear(self.ToggleControls)
        table.clear(self.Categories)

        if gui and gui.Parent then
            gui:Destroy()
        end
    end

    task.defer(function()
        if self.Destroyed then
            return
        end

        local camera = workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            local width = math.min(window.AbsoluteSize.X, viewport.X)
            local height = math.min(window.AbsoluteSize.Y, viewport.Y)

            window.Size = UDim2.fromOffset(width, height)
            window.Position = UDim2.fromOffset(viewport.X / 2, viewport.Y / 2)
            windowPosition = window.Position
            windowSize = window.Size
        end

        updateGrid()
    end)

    return self
end

return Library
