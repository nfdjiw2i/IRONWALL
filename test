updateProperties = function()
    if not UI.main.Visible then
        return
    end
    if editingPropertyBox and editingPropertyBox:IsFocused() then
        return
    end

    clear(UI.propScroll)

    if not selected then
        text(UI.propScroll, "Select an instance.", UDim2.new(1, -16, 0, 30), UDim2.new(0, 8, 0, 8), C.muted, Enum.Font.Code)
        UI.propScroll.CanvasSize = UDim2.new()
        return
    end

    local q = propertyQuery:lower()
    local count = 0

    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 58)
    header.BackgroundColor3 = C.panel3
    header.BackgroundTransparency = 0.04
    header.BorderSizePixel = 0
    header.Parent = UI.propScroll
    corner(header, 7)
    stroke(header, C.line2, 1, 0.22)
    text(header, icon(selected) .. "  " .. selected.Name, UDim2.new(1, -16, 0, 22), UDim2.new(0, 8, 0, 6), C.white, Enum.Font.Code)
    text(header, selected.ClassName, UDim2.new(1, -16, 0, 16), UDim2.new(0, 8, 0, 30), C.muted, Enum.Font.Code)

    if selected:IsA("RemoteEvent") or selected:IsA("RemoteFunction") then
        addProperty("Path", pathOf(selected))
        addProperty("Type", selected.ClassName)
        addProperty("Parent", selected.Parent and selected.Parent:GetFullName() or "nil")
        addProperty("Archivable", selected.Archivable)
    else
        for _, name in ipairs(properties) do
            if q == "" or name:lower():find(q, 1, true) then
                local ok, value = pcall(function()
                    return selected[name]
                end)

                if ok and value ~= nil then
                    addProperty(name, value)
                    count += 1
                elseif name == "Position" and selected:IsA("Model") then
                    addProperty(name, selected:GetPivot().Position)
                    count += 1
                elseif name == "CFrame" and selected:IsA("Model") then
                    addProperty(name, selected:GetPivot())
                    count += 1
                elseif name == "WorldPivot" and selected:IsA("Model") then
                    addProperty(name, selected.WorldPivot)
                    count += 1
                end
            end
        end
    end

    UI.propScroll.CanvasSize = UDim2.new(0, 0, 0, UI.propLayout.AbsoluteContentSize.Y + 10)
    if count > 0 then
        setStatus("INSPECT: " .. selected.ClassName .. "  |  PROPS: " .. count)
    end
end

