local function closeSettings()
    settingsPanel.Visible = false
end

local function applyWatchdogSettings()
    local fps = tonumber(fpsBox.Text)
    local duration = tonumber(durationBox.Text)
    watchdogFpsThreshold = math.clamp(fps or 30, 5, 240)
    watchdogDuration = math.clamp(duration or 2, 0.5, 30)
    fpsBox.Text = tostring(watchdogFpsThreshold)
    durationBox.Text = string.format("%.1f", watchdogDuration)
    watchdogLowTime = 0
    watchdogCooldown = 0
    settingsState.Text = watchdogEnabled and "ARMED" or "DISABLED"
    setStatus("STATUS: GUARD " .. (watchdogEnabled and "ON" or "OFF") .. " | " .. tostring(watchdogFpsThreshold) .. " FPS / " .. string.format("%.1fs", watchdogDuration))
end

local function triggerPerformanceAlarm()
    if alarmActive or not watchdogArmed then
        return
    end

    alarmActive = true
    loadingPaused = true
    watchdogLowTime = 0
    disconnectAll()
    UI.context.Visible = false
    settingsPanel.Visible = false
    UI.main.Visible = false
    minimized = false
    UI.mini.Text = "ALARM"
    UI.mini.TextSize = 10
    UI.mini.Visible = true
    UI.alarmText.Text = string.format("FPS < %d for %.1fs  //  LOADING HALTED", watchdogFpsThreshold, watchdogDuration)
    UI.alarmPanel.Visible = true
end

local function restoreAfterAlarm()
    alarmActive = false
    loadingPaused = false
    watchdogLowTime = 0
    watchdogCooldown = 5
    minimized = false
    UI.alarmPanel.Visible = false
    UI.mini.Text = "UI"
    UI.mini.TextSize = 13
    UI.mini.Visible = false
    UI.main.Visible = true
    scheduleTreeRefresh(0)
    updateProperties()
end

local function updatePerformanceGuardSample(fps, elapsed)
    if not watchdogArmed or not watchdogEnabled or alarmActive then
        return
    end
    if watchdogCooldown > 0 then
        watchdogCooldown = math.max(0, watchdogCooldown - elapsed)
        watchdogLowTime = 0
        return
    end
    if fps < watchdogFpsThreshold then
        watchdogLowTime += elapsed
        if watchdogLowTime >= watchdogDuration then
            triggerPerformanceAlarm()
        end
    else
        watchdogLowTime = 0
    end
end

local function startPerformanceSampler()
    if performanceSampling then return end
    performanceSampling = true
    task.spawn(function()
        local last = os.clock()
        while performanceSampling and gui.Parent do
            task.wait(0.75)
            local now = os.clock()
            local elapsed = math.max(0.25, now - last)
            last = now
            local fps = workspace:GetRealPhysicsFPS()
            updatePerformanceGuardSample(fps, elapsed)
        end
    end)
end

local function minimizeToSquare()
    if minimized then return end
    minimized = true
    loadingPaused = true
    refreshQueued = false
    disconnectAll()
    UI.main.Visible = false
    UI.mini.Text = "UI"
    UI.mini.TextSize = 13
    UI.mini.Visible = true
    if miniSavedPosition then
        UI.mini.Position = miniSavedPosition
    elseif not miniHasCustomPosition then
        UI.mini.Position = UDim2.new(0.5, -UI.mini.Size.X.Offset / 2, 0.5, -15)
    end
end

local function restoreFromSquare()
    if alarmActive then
        restoreAfterAlarm()
        return
    end
    if not minimized then return end
    minimized = false
    UI.mini.Visible = false
    UI.main.Visible = true
    loadingPaused = false
    if currentRoot then
        renderChildren(currentRoot)
    end
    updateProperties()
end

