local function corner(parent, radius)
    return nil
end

local function stroke(parent, color, thickness, transparency)
    local x = Instance.new("UIStroke")
    x.Color = color or C.line
    x.Thickness = thickness or 1
    x.Transparency = transparency or 0
    x.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    x.Parent = parent
    return x
end

local function tween(obj, time, props)
    TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function text(parent, value, size, position, color, font)
    local x = Instance.new("TextLabel")
    x.BackgroundTransparency = 1
    x.Size = size
    x.Position = position or UDim2.new()
    x.Text = value
    x.TextColor3 = color or C.text
    x.TextSize = 12
    x.Font = font or Enum.Font.Code
    x.TextXAlignment = Enum.TextXAlignment.Left
    x.TextYAlignment = Enum.TextYAlignment.Center
    x.Parent = parent
    return x
end

local function button(parent, value, size, position)
    local x = Instance.new("TextButton")
    x.Size = size
    x.Position = position or UDim2.new()
    x.BackgroundColor3 = C.panel2
    x.BackgroundTransparency = 0.06
    x.BorderSizePixel = 0
    x.AutoButtonColor = false
    x.Text = value
    x.TextColor3 = C.text
    x.TextSize = 12
    x.Font = Enum.Font.Code
    x.Parent = parent
    x.ZIndex = 60
    x.TextSize = 12
    corner(x, 7)
    stroke(x, C.line2, 1, 0.05)
    x.ClipsDescendants = true
    local sweep = Instance.new("Frame")
    sweep.Size = UDim2.new(0, 58, 1, 0)
    sweep.Position = UDim2.new(0, -70, 0, 0)
    sweep.BackgroundColor3 = C.white
    sweep.BackgroundTransparency = 0.94
    sweep.BorderSizePixel = 0
    sweep.ZIndex = x.ZIndex - 1
    sweep.Parent = x
    local sg = Instance.new("UIGradient")
    sg.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0.15),NumberSequenceKeypoint.new(1,1)})
    sg.Parent = sweep
    x.MouseEnter:Connect(function()
        tween(x, 0.12, {BackgroundColor3 = C.hover, TextColor3 = C.white})
    end)
    x.MouseLeave:Connect(function()
        tween(x, 0.12, {BackgroundColor3 = C.panel2, TextColor3 = C.text})
    end)
    return x
end

local function input(parent, placeholder, size, position)
    local x = Instance.new("TextBox")
    x.Size = size
    x.Position = position or UDim2.new()
    x.BackgroundColor3 = C.surface
    x.BackgroundTransparency = 0.04
    x.BorderSizePixel = 0
    x.PlaceholderText = placeholder
    x.PlaceholderColor3 = C.soft
    x.TextColor3 = C.white
    x.TextSize = 12
    x.Font = Enum.Font.Code
    x.ZIndex = 50
    x.ClearTextOnFocus = false
    x.Text = ""
    x.TextXAlignment = Enum.TextXAlignment.Left
    x.Parent = parent
    corner(x, 7)
    stroke(x, C.line, 1, 0.18)
    return x
end

local function circle(parent, size, position, transparency)
    local x = Instance.new("Frame")
    x.Size = UDim2.new(0, size, 0, size)
    x.Position = position
    x.BackgroundTransparency = 1
    x.BorderSizePixel = 0
    x.ZIndex = 3
    x.Parent = parent
    local st = Instance.new("UIStroke")
    st.Color = C.line2
    st.Thickness = 1
    st.Transparency = transparency or 0.78
    st.Parent = x
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1,0)
    c.Parent = x
    return x
end

local function divider(parent, position, size)
    local x = Instance.new("Frame")
    x.Position = position
    x.Size = size
    x.BackgroundColor3 = C.line
    x.BackgroundTransparency = 0.35
    x.BorderSizePixel = 0
    x.Parent = parent
    return x
end

