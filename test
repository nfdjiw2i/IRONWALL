local function setMiniWindow(titleText)
    local savedPosition = miniSavedPosition
    UI.mini.Size = UDim2.new(0, math.max(78, #titleText * 7 + 30), 0, 30)
    if savedPosition then
        UI.mini.Position = savedPosition
    elseif not miniHasCustomPosition then
        UI.mini.Position = UDim2.new(0.5, -UI.mini.Size.X.Offset / 2, 0.5, -15)
    end
    UI.mini.Text = titleText
    UI.mini.TextSize = 11
    UI.mini.Visible = true
end

local function hideActiveWindow()
    if not UI.activeWindow or not UI.activeWindow.panel then return end
    local hidden = UI.activeWindow
    hidden.panel.Visible = false
    UI.hiddenWindow = hidden
    if hidden.panel == UI.main then
        loadingPaused = true
        refreshQueued = false
        disconnectAll()
    end
    setMiniWindow(hidden.title)
end

local function restoreActiveWindow()
    if not UI.hiddenWindow or not UI.hiddenWindow.panel then return end
    local restored = UI.hiddenWindow
    restored.panel.Parent = gui
    restored.panel.Visible = true
    UI.activeWindow = restored
    UI.hiddenWindow = nil
    UI.mini.Visible = false
    if restored.panel == UI.main then
        loadingPaused = false
        if currentRoot then
            renderChildren(currentRoot)
        end
        updateProperties()
    end
end

local function closeWindow(panel)
    if panel == UI.main or panel == UI.moduleMenu then
        watchdogArmed = false
        loadingPaused = true
        alarmActive = false
        disconnectAll()
        gui:Destroy()
        return
    end
    panel.Visible = false
    panel.Parent = gui
    UI.hiddenWindow = nil
    UI.mini.Visible = false
    showModuleMenu()
end

