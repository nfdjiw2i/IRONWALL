local function scheduleTreeRefresh(delayTime)
    if loadingPaused or alarmActive or refreshQueued or not UI.main.Visible then
        return
    end
    refreshQueued = true
    task.delay(delayTime or 0.15, function()
        refreshQueued = false
        if loadingPaused or alarmActive or not UI.main.Visible then
            return
        end
        renderChildren(currentRoot)
    end)
end

function renderChildren(root)
    if loadingPaused or alarmActive or not UI.main.Visible then
        return
    end

    disconnectAll()
    clear(UI.tree)
    rowMap = {}

    local function matches(obj)
        local query = UI.search.Text:lower()
        if query == "" then
            return true
        end
        local target = searchMode == "NAME" and obj.Name or obj.ClassName
        return target:lower():find(query, 1, true) ~= nil
    end

    local function makeRow(obj, depth)
        if not matches(obj) then
            return
        end

        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -4, 0, 30)
        row.BackgroundColor3 = selected == obj and C.panel3 or C.panel2
        row.BackgroundTransparency = 0
        row.BorderSizePixel = 0
        row.AutoButtonColor = false
        row.Text = ""
        row.Parent = UI.tree
        corner(row, 5)
        stroke(row, C.line, 1, 0.55)
        rowMap[obj] = row

        local indent = 6 + depth * 17

        local arrow = button(row, expanded[obj] and "⌄" or "›", UDim2.new(0, 24, 0, 25), UDim2.new(0, indent, 0, 3))
        arrow.ZIndex = 2
        arrow.TextSize = 14
        arrow.TextColor3 = isContainer(obj) and C.text or C.soft
        arrow.Visible = isContainer(obj)

        local ico = text(row, icon(obj), UDim2.new(0, 20, 1, 0), UDim2.new(0, indent + 27, 0, 0), C.white, Enum.Font.Code)
        ico.TextXAlignment = Enum.TextXAlignment.Center

        local nameLabel = text(row, obj.Name, UDim2.new(1, -210 - indent, 1, 0), UDim2.new(0, indent + 51, 0, 0), C.text, Enum.Font.Code)
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd

        local classLabel = text(row, obj.ClassName, UDim2.new(0, 135, 1, 0), UDim2.new(1, -142, 0, 0), C.muted, Enum.Font.Code)
        classLabel.TextXAlignment = Enum.TextXAlignment.Right

        row.MouseEnter:Connect(function()
            if selected ~= obj then
                tween(row, 0.1, {BackgroundColor3 = C.hover})
            end
        end)

        row.MouseLeave:Connect(function()
            if selected ~= obj then
                tween(row, 0.1, {BackgroundColor3 = C.panel2})
            end
        end)

        row.MouseButton1Click:Connect(function()
            selectObject(obj, row)
        end)

        row.MouseButton2Click:Connect(function()
            showContext(obj)
        end)

        arrow.MouseButton1Click:Connect(function()
            expanded[obj] = not expanded[obj] or nil
            renderChildren(root)
        end)

        if expanded[obj] then
            local children = obj:GetChildren()
            table.sort(children, function(a, b)
                local ac = a.ClassName
                local bc = b.ClassName
                if ac == bc then
                    return a.Name:lower() < b.Name:lower()
                end
                return ac < bc
            end)

            for _, child in ipairs(children) do
                makeRow(child, depth + 1)
            end
        end
    end

    local children = root:GetChildren()
    table.sort(children, function(a, b)
        local ac = a.ClassName
        local bc = b.ClassName
        if ac == bc then
            return a.Name:lower() < b.Name:lower()
        end
        return ac < bc
    end)

    for _, child in ipairs(children) do
        makeRow(child, 0)
    end

    UI.tree.CanvasSize = UDim2.new(0, 0, 0, UI.treeLayout.AbsoluteContentSize.Y + 10)
    UI.breadcrumb.Text = "ROOT: " .. root.Name .. "  |  " .. #children .. " CHILDREN"
    setStatus("STATUS: READY")

    connections[#connections + 1] = root.ChildAdded:Connect(function()
        scheduleTreeRefresh(0.2)
    end)

    connections[#connections + 1] = root.ChildRemoved:Connect(function()
        scheduleTreeRefresh(0.2)
    end)
end

