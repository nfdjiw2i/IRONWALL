local readOnlyProperties = {
    ClassName = true,
    AbsolutePosition = true,
    AbsoluteSize = true,
    Orientation = true,
    Rotation = true,
    WorldPivot = true,
    TargetFilter = true,
    CurrentCamera = true,
    Path = true,
    Type = true
}

local function parsePropertyValue(textValue, currentValue)
    local kind = typeof(currentValue)
    local value = textValue

    if kind == "string" then
        return value
    elseif kind == "boolean" then
        local v = value:lower()
        if v == "true" or v == "1" or v == "yes" or v == "on" then
            return true
        elseif v == "false" or v == "0" or v == "no" or v == "off" then
            return false
        end
    elseif kind == "number" then
        return tonumber(value)
    elseif kind == "Vector2" then
        local x, y = value:match("^%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*$")
        if x and y then return Vector2.new(tonumber(x), tonumber(y)) end
    elseif kind == "Vector3" then
        local x, y, z = value:match("^%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*$")
        if x and y and z then return Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    elseif kind == "Color3" then
        local r, g, b = value:match("^%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d%.]+)%s*$")
        if r and g and b then
            r, g, b = tonumber(r), tonumber(g), tonumber(b)
            if r and g and b then
                if r > 1 or g > 1 or b > 1 then
                    r, g, b = r / 255, g / 255, b / 255
                end
                return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
            end
        end
    elseif kind == "EnumItem" then
        local enumType = tostring(currentValue.EnumType)
        local enumName = value:match("Enum%.[^%.]+%.(.+)") or value
        local enumObject = Enum[enumType]
        if enumObject then
            local ok, item = pcall(function() return enumObject[enumName] end)
            if ok and item then return item end
        end
    elseif kind == "BrickColor" then
        local ok, bc = pcall(function() return BrickColor.new(value) end)
        if ok then return bc end
    end

    return nil
end

local function commitProperty(name, valueBox, object)
    if not object or object.Parent == nil or not valueBox then return false end
    if readOnlyProperties[name] then return false end

    local ok, currentValue = pcall(function()
        return object[name]
    end)
    if not ok or currentValue == nil then return false end

    local parsed = parsePropertyValue(valueBox.Text, currentValue)
    if parsed == nil then
        valueBox.Text = formatValue(currentValue)
        setStatus("STATUS: INVALID VALUE // " .. name)
        return false
    end

    local assigned = pcall(function()
        object[name] = parsed
    end)

    if not assigned then
        valueBox.Text = formatValue(currentValue)
        setStatus("STATUS: READ ONLY // " .. name)
        return false
    end

    local verifyOk, newValue = pcall(function()
        return object[name]
    end)
    if verifyOk and newValue ~= nil then
        valueBox.Text = formatValue(newValue)
    end

    setStatus("STATUS: UPDATED // " .. name)
    return true
end

local function addProperty(name, value)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundColor3 = C.panel2
    row.BackgroundTransparency = 0
    row.BorderSizePixel = 0
    row.Parent = UI.propScroll
    corner(row, 6)
    stroke(row, C.line, 1, 0.35)

    text(row, name, UDim2.new(0.35, -8, 1, 0), UDim2.new(0, 8, 0, 0), C.muted, Enum.Font.Code)

    local valueBox = input(row, "", UDim2.new(0.65, -42, 1, -8), UDim2.new(0.35, 2, 0, 4))
    valueBox.Text = formatValue(value)
    valueBox.TextEditable = not readOnlyProperties[name]
    valueBox.Selectable = true
    valueBox.ClearTextOnFocus = false

    local copyButton = button(row, "COPY", UDim2.new(0, 36, 0, 26), UDim2.new(1, -40, 0, 4))
    copyButton.TextSize = 9
    copyButton.ZIndex = 60
    copyButton.MouseButton1Click:Connect(function()
        copyText(valueBox.Text)
        valueBox:CaptureFocus()
        valueBox.SelectionStart = 1
        valueBox.CursorPosition = #valueBox.Text + 1
    end)

    if not readOnlyProperties[name] then
        valueBox.Focused:Connect(function()
            editingPropertyBox = valueBox
            editingPropertyName = name
            editingPropertyObject = selected
            valueBox.BackgroundColor3 = C.hover
        end)

        valueBox.FocusLost:Connect(function()
            local object = editingPropertyObject
            local propertyName = editingPropertyName
            local box = editingPropertyBox
            editingPropertyBox = nil
            editingPropertyName = nil
            editingPropertyObject = nil
            valueBox.BackgroundColor3 = C.surface

            if box == valueBox and object == selected and propertyName == name then
                commitProperty(name, valueBox, object)
                task.defer(updateProperties)
            end
        end)
    end

    return valueBox
end

