
local Library = {}
Library.__index = Library

local T = {
    Background = Color3.fromRGB(5, 5, 7),
    Sidebar = Color3.fromRGB(8, 8, 11),
    Header = Color3.fromRGB(9, 9, 13),
    Element = Color3.fromRGB(13, 13, 17),
    Hover = Color3.fromRGB(24, 23, 31),
    Selected = Color3.fromRGB(20, 17, 31),
    Border = Color3.fromRGB(42, 38, 53),
    Text = Color3.fromRGB(240, 239, 246),
    Muted = Color3.fromRGB(142, 139, 153),
    Accent = Color3.fromRGB(180, 105, 255),
    AccentDark = Color3.fromRGB(89, 48, 145)
}

local function New(class, props, parent)
    local obj = Instance.new(class)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function Round(obj, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, obj)
end

local function Border(obj, color, thickness)
    return New("UIStroke", {
        Color = color or T.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end

local function Padding(obj, left, right, top, bottom)
    New("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0)
    }, obj)
end

local function List(obj, gap)
    return New("UIListLayout", {
        Padding = UDim.new(0, gap or 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, obj)
end

local function MakeLabel(parent, text, size, color, font)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text),
        TextColor3 = color or T.Text,
        TextSize = size or 13,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function MakeButton(parent, text)
    local button = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = T.Element,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = tostring(text),
        TextColor3 = T.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)

    Round(button, 6)
    Border(button)
    Padding(button, 11, 10, 0, 0)

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = T.Hover
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = T.Element
    end)

    return button
end

function Library:CreateLib(title, themeName)
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local TweenService = game:GetService("TweenService")

    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local previous = playerGui:FindFirstChild("UsureLibrary")
    if previous then
        previous:Destroy()
    end

    local gui = New("ScreenGui", {
        Name = "UsureLibrary",
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, playerGui)

    local self = setmetatable({
        Gui = gui,
        Tabs = {},
        Connections = {},
        Cleanups = {},
        Toggles = {},
        Destroyed = false,
        SelectedTab = nil,
        TabCount = 0,
        Theme = T
    }, Library)

    function self:TrackConnection(connection)
        if connection then
            table.insert(self.Connections, connection)
        end
        return connection
    end

    function self:BindConnection(connection)
        return self:TrackConnection(connection)
    end

    function self:BindCleanup(callback)
        if type(callback) == "function" then
            table.insert(self.Cleanups, callback)
        end
        return callback
    end

    function self:CreateConnection(signal, callback)
        local connection = signal:Connect(callback)
        self:TrackConnection(connection)
        return connection
    end

    function self:CreateTask(callback)
        local alive = true

        self:BindCleanup(function()
            alive = false
        end)

        task.spawn(function()
            local ok, err = pcall(callback, function()
                return alive and not self.Destroyed
            end)

            if not ok and not self.Destroyed then
                warn("[Usure] Task error:", err)
            end
        end)

        return function()
            alive = false
        end
    end

