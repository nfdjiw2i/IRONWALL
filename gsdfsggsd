    }, restore)

    local minimized = false
    local resizing = false
    local resizeOrigin, resizeSize, resizePosition
    local dragging, dragOrigin, dragPosition
    local windowPosition, windowSize = window.Position, window.Size
    local restorePosition = restore.Position
    local categoryDrag, categoryDragOrigin
    local categoryClickPending = false

    local function updateGrid()
        if self.Destroyed then
            return
        end
        local width = grid.AbsoluteSize.X
        local columns = width >= 900 and 3 or (width >= 570 and 2 or 1)
        local gap = 8
        local cellWidth = math.max(180, math.floor((width - gap * (columns - 1)) / columns))
        gridLayout.CellSize = UDim2.fromOffset(cellWidth, 290)
        gridLayout.CellPadding = UDim2.fromOffset(gap, gap)
        local visibleCount = 0
        for _, category in ipairs(self.Categories) do
            if category.Frame.Visible then
                visibleCount += 1
            end
        end
        grid.CanvasSize = UDim2.fromOffset(0, math.ceil(visibleCount / columns) * 298 + 8)
    end

    local function refreshSearch()
        local query = string.lower(self.Search)
        for _, category in ipairs(self.Categories) do
            local found = false
            for _, item in ipairs(category.Items) do
                local matches = query == "" or string.find(string.lower(item.Name), query, 1, true) ~= nil
                item.Frame.Visible = matches
                if matches then
                    found = true
                end
            end
            category.Frame.Visible = query == "" or found
        end
        updateGrid()
    end

    self:Connect(searchBox:GetPropertyChangedSignal("Text"), function()
        self.Search = searchBox.Text
        refreshSearch()
    end)

    local selfWindow = self

    local function sortCategories()
        table.sort(self.Categories, function(a, b)
            if a.Order == b.Order then
                return a.Id < b.Id
            end
            return a.Order < b.Order
        end)
        for i, category in ipairs(self.Categories) do
            category.Frame.LayoutOrder = i
        end
        updateGrid()
    end

    function self:Category(name, order)
        if self.Destroyed then
            return
        end
        self.CategoryIndex += 1
        local id = self.CategoryIndex
        local categoryName = tostring(name or ("CATEGORY " .. id))

        local frame = make("Frame", {
            Name = categoryName,
            BackgroundColor3 = C.surface,
            BackgroundTransparency = 0.14,
            BorderSizePixel = 0,
            ClipsDescendants = true,
            LayoutOrder = tonumber(order) or id,
            ZIndex = 1
        }, grid)
        corner(frame, 8)
        stroke(frame, C.border, 0.1)
        make("UIGradient", {
            Color = ColorSequence.new(Color3.fromRGB(17, 18, 22), C.surface),
            Rotation = 90
        }, frame)

        local header = make("TextButton", {
            Position = UDim2.fromOffset(4, 4),
            Size = UDim2.new(1, -8, 0, 32),
            BackgroundColor3 = C.bg,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 3
        }, frame)
        corner(header, 6)
        stroke(header, C.border, 0.22)

        local headerText = label(header, string.upper(categoryName), 9, C.text, Enum.Font.GothamBold)
        headerText.Position = UDim2.fromOffset(9, 0)
        headerText.Size = UDim2.new(1, -32, 1, 0)
        headerText.ZIndex = 4

        local collapseMark = label(header, "−", 12, C.muted)
        collapseMark.AnchorPoint = Vector2.new(1, 0)
        collapseMark.Position = UDim2.new(1, -8, 0, 0)
        collapseMark.Size = UDim2.fromOffset(15, 32)
        collapseMark.TextXAlignment = Enum.TextXAlignment.Center
        collapseMark.ZIndex = 4

        local content = make("ScrollingFrame", {
            Name = "Items",
            Position = UDim2.fromOffset(5, 42),
            Size = UDim2.new(1, -10, 1, -47),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = C.border,
            CanvasSize = UDim2.new(),
            ScrollingDirection = Enum.ScrollingDirection.Y,
            ZIndex = 2
        }, frame)

        local list = make("UIListLayout", {
            Padding = UDim.new(0, 5),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, content)

        local category = {
            Id = id,
            Name = categoryName,
            Order = tonumber(order) or id,
            Frame = frame,
            Header = header,
            Content = content,
            Items = {},
            Collapsed = false
        }

        local function updateContent()
            content.CanvasSize = UDim2.fromOffset(0, list.AbsoluteContentSize.Y + 5)
        end
        self:Connect(list:GetPropertyChangedSignal("AbsoluteContentSize"), updateContent)

        local function newItem(itemName, height)
            local row = make("Frame", {
                Name = tostring(itemName),
                Size = UDim2.new(1, -2, 0, height),
                BackgroundColor3 = C.row,
                BackgroundTransparency = 0.08,
                BorderSizePixel = 0,
                ZIndex = 2
            }, content)
            corner(row, 7)
            stroke(row, C.border, 0.25)
            local item = {Name = tostring(itemName), Frame = row}
            table.insert(category.Items, item)
            refreshSearch()
            return row, item
        end

        function category:Button(name, description, callback)
            if type(description) == "function" then
                callback = description
            end
            local row, item = newItem(name, 33)
            local button = make("TextButton", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Text = tostring(name),
                TextColor3 = C.text,
                TextSize = 10,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false,
                ZIndex = 3
            }, row)
            corner(button, 7)
            selfWindow:Connect(button.MouseEnter, function()
                row.BackgroundColor3 = C.hover
            end)
            selfWindow:Connect(button.MouseLeave, function()
                row.BackgroundColor3 = C.row
            end)
            selfWindow:Connect(button.MouseButton1Click, function()
                if not selfWindow.Destroyed and type(callback) == "function" then
                    task.spawn(callback)
                end
            end)
            item.Button = button
            item.Description = description
            return button
        end

        function category:Toggle(name, description, callback)
            if type(description) == "function" then
                callback = description
            end
            local row, item = newItem(name, 33)
            local caption = label(row, name, 10, C.text)
            caption.Position = UDim2.fromOffset(10, 0)
            caption.Size = UDim2.new(1, -65, 1, 0)
            caption.ZIndex = 3

            local switch = make("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -9, 0.5, 0),
                Size = UDim2.fromOffset(38, 19),
                BackgroundColor3 = C.hover,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 3
            }, row)
            corner(switch, 10)

            local knob = make("Frame", {
                Position = UDim2.fromOffset(3, 3),
                Size = UDim2.fromOffset(13, 13),
                BackgroundColor3 = C.text,
                BorderSizePixel = 0,
                ZIndex = 4
            }, switch)
            corner(knob, 10)

            local enabled = false
            local control = {}

            function control:Set(value, silent)
                enabled = value == true
                TweenService:Create(switch, TweenInfo.new(0.12), {
                    BackgroundColor3 = enabled and C.enabled or C.hover
                }):Play()
                TweenService:Create(knob, TweenInfo.new(0.12), {
                    Position = enabled and UDim2.new(1, -16, 0, 3) or UDim2.fromOffset(3, 3)
                }):Play()
                if not silent and type(callback) == "function" then
                    task.spawn(callback, enabled)
                end
            end

            function control:Get()
                return enabled
            end

            selfWindow:Connect(switch.MouseButton1Click, function()
                control:Set(not enabled)
            end)
            table.insert(selfWindow.ToggleControls, control)
            item.Toggle = control
            item.Description = description
            return control
        end

        function category:Slider(name, description, minimum, maximum, default, callback)
            minimum = tonumber(minimum) or 0
            maximum = tonumber(maximum) or 100
            default = math.clamp(tonumber(default) or minimum, minimum, maximum)

            local row, item = newItem(name, 56)
            local caption = label(row, name, 10, C.text)
            caption.Position = UDim2.fromOffset(10, 2)
            caption.Size = UDim2.new(1, -55, 0, 21)
            caption.ZIndex = 3

            local valueLabel = label(row, default, 9, C.text)
            valueLabel.AnchorPoint = Vector2.new(1, 0)
            valueLabel.Position = UDim2.new(1, -10, 0, 2)
            valueLabel.Size = UDim2.fromOffset(35, 21)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.ZIndex = 3

            local bar = make("TextButton", {
                Position = UDim2.new(0, 10, 0, 37),
                Size = UDim2.new(1, -20, 0, 4),
                BackgroundColor3 = C.hover,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 3
            }, row)
            corner(bar, 4)

            local fill = make("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = C.accent,
                BorderSizePixel = 0,
                ZIndex = 4
            }, bar)
            corner(fill, 4)

            local knob = make("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.fromOffset(10, 10),
                BackgroundColor3 = C.text,
                BorderSizePixel = 0,
                ZIndex = 5
            }, bar)
            corner(knob, 6)

            local value = default
            local draggingSlider = false
            local control = {}

            local function setValue(newValue, fire)
                value = math.clamp(math.floor(newValue + 0.5), minimum, maximum)
                local alpha = (value - minimum) / math.max(maximum - minimum, 1)
                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = tostring(value)
                if fire and type(callback) == "function" then
                    task.spawn(callback, value)
                end
            end

            local function updateFromInput(input)
                local alpha = math.clamp(
                    (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
                    0, 1
                )
                setValue(minimum + (maximum - minimum) * alpha, true)
            end

            selfWindow:Connect(bar.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = true
                    updateFromInput(input)
                end
            end)

            selfWindow:Connect(UIS.InputChanged, function(input)
                if draggingSlider and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    updateFromInput(input)
                end
            end)

            selfWindow:Connect(UIS.InputEnded, function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = false
                end
            end)

            function control:Set(newValue)
                setValue(newValue, true)
            end

            function control:Get()
                return value
            end

            setValue(default, false)
            item.Slider = control
            item.Description = description
            return control
        end

        function category:SetOrder(newOrder)
            category.Order = tonumber(newOrder) or category.Order
            sortCategories()
        end

        function category:SetCollapsed(value)
            category.Collapsed = value == true
            content.Visible = not category.Collapsed
            collapseMark.Text = category.Collapsed and "+" or "−"
            frame.Size = UDim2.new(0, frame.AbsoluteSize.X, 0, category.Collapsed and 42 or 290)
            content.Size = category.Collapsed
                and UDim2.new(1, -10, 0, 0)
                or UDim2.new(1, -10, 1, -47)
            updateGrid()
        end

        selfWindow:Connect(header.MouseButton1Click, function()
            if not categoryClickPending then
                category:SetCollapsed(not category.Collapsed)
            end
        end)

        selfWindow:Connect(header.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                categoryDrag = category
                categoryDragOrigin = input.Position
                categoryClickPending = false
            end
        end)

        selfWindow:Connect(UIS.InputEnded, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not categoryDrag then
                return
            end
            local dragged = categoryDrag
            categoryDrag = nil
            if not categoryDragOrigin or (input.Position - categoryDragOrigin).Magnitude < 10 then
                categoryDragOrigin = nil
                return
            end

            categoryClickPending = true
            local nearest, nearestDistance
            for _, other in ipairs(selfWindow.Categories) do
                if other ~= dragged and other.Frame.Visible then
                    local center = other.Frame.AbsolutePosition + other.Frame.AbsoluteSize / 2
                    local distance = (center - input.Position).Magnitude
                    if not nearestDistance or distance < nearestDistance then
                        nearest, nearestDistance = other, distance
                    end
                end
            end
            if nearest then
                dragged.Order, nearest.Order = nearest.Order, dragged.Order
                sortCategories()
            end
            task.defer(function()
                categoryClickPending = false
            end)
            categoryDragOrigin = nil
        end)

        table.insert(self.Categories, category)
        sortCategories()
        return category
    end

    function self:CategoryOrder(names)
        for order, name in ipairs(names) do
            for _, category in ipairs(self.Categories) do
                if string.lower(category.Name) == string.lower(name) then
                    category.Order = order
                end
            end
        end
        sortCategories()
    end

    local function collapseAll(value)
        for _, category in ipairs(self.Categories) do
            category:SetCollapsed(value)
        end
    end

    self:Connect(collapseButton.MouseButton1Click, function()
        collapseAll(true)
    end)
    self:Connect(expandButton.MouseButton1Click, function()
        collapseAll(false)
    end)
    self:Connect(topButton.MouseButton1Click, function()
        grid.CanvasPosition = Vector2.zero
    end)

    local function hideWindow()
        if self.Destroyed or minimized then
            return
        end
        windowPosition = window.Position
        windowSize = window.Size
        restorePosition = UDim2.fromOffset(
            window.AbsolutePosition.X + window.AbsoluteSize.X - 28,
            window.AbsolutePosition.Y + 28
        )
        minimized = true
        window.Visible = false
        restore.Position = restorePosition
        restore.Visible = true
    end

    local function showWindow()
        if self.Destroyed then
            return
        end
        minimized = false
        restore.Visible = false
        window.Visible = true
        window.Position = windowPosition
        window.Size = windowSize
    end

    self:Connect(restore.MouseButton1Click, showWindow)
    self:Connect(close.MouseButton1Click, function()
        self:Destroy()
    end)

    self:Connect(UIS.InputBegan, function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.LeftAlt then
            if minimized then
                showWindow()
            else
                hideWindow()
            end
        end
    end)

    self:Connect(topbar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = window
            dragOrigin = input.Position
            dragPosition = window.Position
        end
    end)

    self:Connect(restore.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = restore
            dragOrigin = input.Position
            dragPosition = restore.Position
        end
    end)

    self:Connect(UIS.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragOrigin
            local pos = UDim2.fromOffset(
                dragPosition.X.Offset + delta.X,
                dragPosition.Y.Offset + delta.Y
            )
            dragging.Position = pos
            if dragging == window then
                windowPosition = pos
            else
                restorePosition = pos
            end
        end

        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - resizeOrigin
            local width = math.clamp(resizeSize.X + delta.X, 600, 1600)
            local height = math.clamp(resizeSize.Y + delta.Y, 400, 1100)
            window.Size = UDim2.fromOffset(width, height)
            window.Position = resizePosition
            windowPosition = resizePosition
            windowSize = window.Size
            updateGrid()
        end
    end)

    self:Connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = nil
            resizing = false
        end
    end)

    self:Connect(resize.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            resizeOrigin = input.Position
            resizeSize = window.AbsoluteSize
            resizePosition = window.Position
        end
    end)

    self:Connect(grid:GetPropertyChangedSignal("AbsoluteSize"), updateGrid)
    self:Connect(window:GetPropertyChangedSignal("AbsoluteSize"), updateGrid)

    function self:Destroy()
        if self.Destroyed then
            return
        end
        self.Destroyed = true

        for _, control in ipairs(self.ToggleControls) do
            pcall(function()
                control:Set(false)
            end)
        end

        for _, callback in ipairs(self.CleanupCallbacks) do
            pcall(callback)
        end

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(self.Connections)
        table.clear(self.CleanupCallbacks)
        table.clear(self.ToggleControls)
        gui:Destroy()
    end

    self:Connect(close.MouseEnter, function()
        close.BackgroundColor3 = C.hover
        close.TextColor3 = C.text
    end)
    self:Connect(close.MouseLeave, function()
        close.BackgroundColor3 = C.row
        close.TextColor3 = C.muted
    end)

    task.defer(function()
        if self.Destroyed then
            return
        end
        local camera = workspace.CurrentCamera
        if camera then
            local viewport = camera.ViewportSize
            local width, height = window.AbsoluteSize.X, window.AbsoluteSize.Y
            window.Position = UDim2.fromOffset(
                math.max(0, (viewport.X - width) / 2),
                math.max(0, (viewport.Y - height) / 2)
            )
            windowPosition = window.Position
        end
        updateGrid()
    end)

    return self
end

return Library
