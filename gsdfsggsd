local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local C = {
    bg = Color3.fromRGB(6, 7, 9),
    surface = Color3.fromRGB(11, 12, 15),
    row = Color3.fromRGB(18, 19, 23),
    hover = Color3.fromRGB(31, 33, 39),
    border = Color3.fromRGB(57, 60, 69),
    text = Color3.fromRGB(242, 243, 247),
    muted = Color3.fromRGB(153, 157, 167),
    accent = Color3.fromRGB(190, 204, 231),
    enabled = Color3.fromRGB(76, 94, 130)
}

local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 7)}, obj)
end

local function stroke(obj, color, transparency)
    make("UIStroke", {
        Color = color or C.border,
        Transparency = transparency or 0,
        Thickness = 1
    }, obj)
end

local function label(parent, text, size, color, font)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = color or C.text,
        TextSize = size or 10,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

