    local function SaveWindowPosition()
        savedWindowPosition = window.Position
        savedWindowSize = window.Size
    end

    local function ShowWindow()
        if self.Destroyed then
            return
        end

        minimized = false
        floating.Visible = false
        window.Visible = true
        window.Position = savedWindowPosition
        window.Size = savedWindowSize
    end

    local function HideToIcon()
        if self.Destroyed or minimized then
            return
        end

        SaveWindowPosition()
        minimized = true
        floating.Position = savedFloatingPosition
        floating.Visible = true
        window.Visible = false
    end

    function self:SetVisible(value)
        if value then
            ShowWindow()
        else
            HideToIcon()
        end
    end

    function self:SetTitle(value)
        titleLabel.Text = tostring(value)
    end

    function self:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, toggle in ipairs(self.Toggles) do
            pcall(function()
                toggle:Set(false, true)
            end)
        end

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        for _, callback in ipairs(self.Cleanups) do
            pcall(callback)
        end

        table.clear(self.Connections)
        table.clear(self.Cleanups)
        table.clear(self.Toggles)

        gui:Destroy()
    end

    local function SelectTab(tab)
        if self.Destroyed then
            return
        end

        self.SelectedTab = tab

        for _, other in ipairs(self.Tabs) do
            local selected = other == tab

            other.Page.Visible = selected
            other.Indicator.Visible = selected
            other.Button.BackgroundColor3 =
                selected and T.Selected or T.Sidebar
            other.Button.TextColor3 =
                selected and T.Text or T.Muted
        end
    end

    function self:NewTab(tabName)
        if self.Destroyed then
            return
        end

        self.TabCount += 1

        local button = New("TextButton", {
            Name = tostring(tabName),
            Size = UDim2.new(1, 0, 0, 39),
            BackgroundColor3 = T.Sidebar,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "   " .. tostring(tabName),
            TextColor3 = T.Muted,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = self.TabCount
        }, tabList)

        Round(button, 4)

        local indicator = New("Frame", {
            Position = UDim2.fromOffset(0, 4),
            Size = UDim2.new(0, 2, 1, -8),
            BackgroundColor3 = T.Accent,
            BorderSizePixel = 0,
            Visible = false
        }, button)

        local page = New("ScrollingFrame", {
            Name = tostring(tabName) .. "Page",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = T.AccentDark,
            CanvasSize = UDim2.new(),
            Visible = false
        }, pages)

        Padding(page, 14, 14, 15, 15)

        local pageLayout = List(page, 13)

        local function UpdatePage()
            page.CanvasSize = UDim2.fromOffset(
                0,
                pageLayout.AbsoluteContentSize.Y + 30
            )
        end

        self:TrackConnection(
            pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdatePage)
        )

        local tab = {
            Name = tabName,
            Button = button,
            Indicator = indicator,
            Page = page,
            Sections = {}
        }

        function tab:NewSection(sectionName)
            local sectionFrame = New("Frame", {
                Name = tostring(sectionName),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                BorderSizePixel = 0
            }, page)

            local heading = MakeLabel(
                sectionFrame,
                sectionName,
                17,
                T.Text,
                Enum.Font.GothamMedium
            )

            heading.Size = UDim2.new(1, 0, 0, 28)

            local elements = New("Frame", {
                Position = UDim2.fromOffset(0, 32),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                BorderSizePixel = 0
            }, sectionFrame)

            local elementLayout = List(elements, 6)

            self.Window = self.Window or nil

            local section = {
                Frame = sectionFrame,
                Elements = elements,
                Tab = tab
            }

            elementLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                elements.Size = UDim2.new(
                    1, 0, 0, elementLayout.AbsoluteContentSize.Y
                )
                UpdatePage()
            end)

            function section:NewButton(name, description, callback)
                if type(description) == "function" then
                    callback = description
                end

                local button = MakeButton(elements, name)

                button.MouseButton1Click:Connect(function()
                    if self.Library and self.Library.Destroyed then
                        return
                    end

                    if type(callback) == "function" then
                        task.spawn(callback)
                    end
                end)

                return button
            end

            function section:NewToggle(name, description, callback)
                if type(description) == "function" then
                    callback = description
                end

                local state = false

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 37),
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0
                }, elements)

                Round(row, 6)
                Border(row)

                local text = MakeLabel(row, name, 13, T.Text)
                text.Position = UDim2.fromOffset(11, 0)
                text.Size = UDim2.new(1, -65, 1, 0)

                local switch = New("TextButton", {
                    Position = UDim2.new(1, -45, 0.5, -9),
                    Size = UDim2.fromOffset(34, 18),
                    BackgroundColor3 = T.Hover,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                }, row)

                Round(switch, 9)

                local knob = New("Frame", {
                    Position = UDim2.fromOffset(2, 2),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundColor3 = T.Muted,
                    BorderSizePixel = 0
                }, switch)

                Round(knob, 8)

                local toggle = {}

                function toggle:Set(value, cleanupOnly)
                    if state == (value == true) then
                        return
                    end

                    state = value == true
                    switch.BackgroundColor3 = state and T.Accent or T.Hover
                    knob.BackgroundColor3 = state and T.Background or T.Muted
                    knob.Position = state
                        and UDim2.new(1, -16, 0, 2)
                        or UDim2.fromOffset(2, 2)

                    if type(callback) == "function" then
                        task.spawn(callback, state)
                    end
                end

                function toggle:Get()
                    return state
                end

                switch.MouseButton1Click:Connect(function()
                    if not self.Library or not self.Library.Destroyed then
                        toggle:Set(not state)
                    end
                end)

                table.insert(self.Library and self.Library.Toggles or {}, toggle)

                return toggle
            end

            function section:NewSlider(name, description, minValue, maxValue, defaultValue, callback)
                if type(description) ~= "string" then
                    callback = defaultValue
                    defaultValue = maxValue
                    maxValue = minValue
                    minValue = description
                end

                minValue = tonumber(minValue) or 0
                maxValue = tonumber(maxValue) or 100
                defaultValue = math.clamp(
                    tonumber(defaultValue) or minValue,
                    minValue,
                    maxValue
                )

                local value = defaultValue

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 58),
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0
                }, elements)

                Round(row, 6)
                Border(row)

                local text = MakeLabel(row, name, 13, T.Text)
                text.Position = UDim2.fromOffset(11, 3)
                text.Size = UDim2.new(1, -80, 0, 23)

                local valueLabel = MakeLabel(row, value, 12, T.Muted)
                valueLabel.Position = UDim2.new(1, -65, 0, 3)
                valueLabel.Size = UDim2.fromOffset(53, 23)
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right

                local bar = New("TextButton", {
                    Position = UDim2.new(0, 11, 0, 36),
                    Size = UDim2.new(1, -22, 0, 4),
                    BackgroundColor3 = T.Hover,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                }, row)

                Round(bar, 4)

                local fill = New("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = T.Accent,
                    BorderSizePixel = 0
                }, bar)

                Round(fill, 4)

                local knob = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.fromOffset(10, 10),
                    BackgroundColor3 = T.Text,
                    BorderSizePixel = 0
                }, bar)

                Round(knob, 8)

                local sliding = false
                local slider = {}

                local function setValue(newValue, callCallback)
                    value = math.clamp(
                        math.floor(newValue + 0.5),
                        minValue,
                        maxValue
                    )

                    local alpha = (value - minValue)
                        / math.max(maxValue - minValue, 1)

                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                    valueLabel.Text = tostring(value)

                    if callCallback and type(callback) == "function" then
                        task.spawn(callback, value)
                    end
                end

                local function update(inputObject)
                    local width = math.max(bar.AbsoluteSize.X, 1)
                    local alpha = math.clamp(
                        (inputObject.Position.X - bar.AbsolutePosition.X) / width,
                        0,
                        1
                    )

                    setValue(minValue + (maxValue - minValue) * alpha, true)
                end

                bar.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                        or inputObject.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        update(inputObject)
                    end
                end)

                self.Library:TrackConnection(UIS.InputChanged:Connect(function(inputObject)
                    if sliding and (
                        inputObject.UserInputType == Enum.UserInputType.MouseMovement
                        or inputObject.UserInputType == Enum.UserInputType.Touch
                    ) then
                        update(inputObject)
                    end
                end))

                self.Library:TrackConnection(UIS.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                        or inputObject.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end))

                function slider:Set(newValue)
                    setValue(newValue, true)
                end

                function slider:Get()
                    return value
                end

                setValue(defaultValue, false)
                return slider
            end

            function section:NewTextBox(name, description, callback)
                if type(description) == "function" then
                    callback = description
                end

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0
                }, elements)

                Round(row, 6)
                Border(row)

                local box = New("TextBox", {
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(1, -22, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    PlaceholderText = tostring(name),
                    PlaceholderColor3 = T.Muted,
                    TextColor3 = T.Text,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, row)

                box.FocusLost:Connect(function(enterPressed)
                    if type(callback) == "function" then
                        task.spawn(callback, box.Text, enterPressed)
                    end
                end)

                return box
            end

            function section:NewLabel(textValue)
                local label = MakeLabel(elements, textValue, 13, T.Muted)
                label.Size = UDim2.new(1, 0, 0, 24)
                return label
            end

            table.insert(tab.Sections, section)
            return section
        end

        button.MouseButton1Click:Connect(function()
            SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)

        if #self.Tabs == 1 then
            SelectTab(tab)
        end

        self:TrackConnection(tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabList.CanvasSize = UDim2.fromOffset(
                0,
                tabLayout.AbsoluteContentSize.Y + 10
            )
        end))

        return tab
    end

    local function DragObject(object, handle, onPositionChanged)
        local dragging = false
        local startInput
        local startPosition
        local dragInput

        handle.InputBegan:Connect(function(inputObject)
            if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                or inputObject.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                startInput = inputObject.Position
                startPosition = object.Position

                inputObject.Changed:Connect(function()
                    if inputObject.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        if onPositionChanged then
                            onPositionChanged()
                        end
                    end
                end)
            end
        end)

        handle.InputChanged:Connect(function(inputObject)
            if inputObject.UserInputType == Enum.UserInputType.MouseMovement
                or inputObject.UserInputType == Enum.UserInputType.Touch then
                dragInput = inputObject
            end
        end)

        self:TrackConnection(UIS.InputChanged:Connect(function(inputObject)
            if dragging and inputObject == dragInput then
                local delta = inputObject.Position - startInput

                object.Position = UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale,
                    startPosition.Y.Offset + delta.Y
                )
            end
        end))

        self:TrackConnection(UIS.InputEnded:Connect(function(inputObject)
            if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                or inputObject.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end

    DragObject(topbar, topbar, SaveWindowPosition)

    local resizeActive = false
    local resizeStart
    local resizeOriginal

    resize.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1
            or inputObject.UserInputType == Enum.UserInputType.Touch then
            resizeActive = true
            resizeStart = inputObject.Position
            resizeOriginal = window.AbsoluteSize
        end
    end)

    self:TrackConnection(UIS.InputChanged:Connect(function(inputObject)
        if resizeActive and (
            inputObject.UserInputType == Enum.UserInputType.MouseMovement
            or inputObject.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = inputObject.Position - resizeStart
            local viewport = workspace.CurrentCamera
                and workspace.CurrentCamera.ViewportSize

            local maxWidth = viewport and math.max(400, viewport.X - 20) or 1400
            local maxHeight = viewport and math.max(300, viewport.Y - 20) or 1000

            local width = math.clamp(resizeOriginal.X + delta.X, 500, maxWidth)
            local height = math.clamp(resizeOriginal.Y + delta.Y, 320, maxHeight)

            window.Size = UDim2.fromOffset(width, height)
            normalSize = window.Size
            savedWindowSize = window.Size
        end
    end))

    self:TrackConnection(UIS.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1
            or inputObject.UserInputType == Enum.UserInputType.Touch then
            resizeActive = false
        end
    end))

    DragObject(floating, floating, function()
        savedFloatingPosition = floating.Position
    end)

    floating.MouseButton1Click:Connect(function()
        ShowWindow()
    end)

    minimize.MouseButton1Click:Connect(HideToIcon)

    maximize.MouseButton1Click:Connect(function()
        if maximized then
            maximized = false
            window.Size = savedWindowSize
            window.Position = savedWindowPosition
        else
            SaveWindowPosition()
            maximized = true

            local camera = workspace.CurrentCamera
            local viewport = camera and camera.ViewportSize

            if viewport then
                window.AnchorPoint = Vector2.new(0.5, 0.5)
                window.Position = UDim2.fromScale(0.5, 0.5)
                window.Size = UDim2.fromOffset(
                    math.max(500, viewport.X - 30),
                    math.max(320, viewport.Y - 30)
                )
            end
        end
    end)

    close.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    self:TrackConnection(UIS.InputBegan:Connect(function(inputObject, processed)
        if not processed and inputObject.KeyCode == Enum.KeyCode.RightControl then
            if minimized then
                ShowWindow()
            elseif window.Visible then
                HideToIcon()
            else
                ShowWindow()
            end
        end
    end))

    self:BindCleanup(function()
        resizeActive = false
        minimized = false
        floating.Visible = false
    end)

    return self
end

return Library
