
local Library = {}
Library.__index = Library

local T = {
    Background = Color3.fromRGB(8, 8, 8),
    Sidebar = Color3.fromRGB(10, 10, 10),
    Header = Color3.fromRGB(12, 12, 12),
    Element = Color3.fromRGB(15, 15, 15),
    Hover = Color3.fromRGB(27, 27, 27),
    Selected = Color3.fromRGB(31, 31, 31),
    Border = Color3.fromRGB(43, 43, 43),
    Text = Color3.fromRGB(238, 238, 238),
    Muted = Color3.fromRGB(145, 145, 145),
    Accent = Color3.fromRGB(235, 235, 235)
}

local function New(class, props, parent)
    local obj = Instance.new(class)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function Round(obj, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0, radius or 5)
    }, obj)
end

local function Border(obj)
    New("UIStroke", {
        Color = T.Border,
        Thickness = 1
    }, obj)
end

local function AddList(parent, gap)
    return New("UIListLayout", {
        Padding = UDim.new(0, gap or 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, parent)
end

local function AddPadding(parent, left, right, top, bottom)
    New("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0)
    }, parent)
end

local function Label(parent, text, size, color, font)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text),
        TextColor3 = color or T.Text,
        TextSize = size or 13,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function ElementButton(parent, name)
    local button = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = T.Element,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = tostring(name),
        TextColor3 = T.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)

    Round(button, 5)
    Border(button)
    AddPadding(button, 11, 10, 0, 0)

    button.MouseEnter:Connect(function()
        button.BackgroundColor3 = T.Hover
    end)

    button.MouseLeave:Connect(function()
        button.BackgroundColor3 = T.Element
    end)

    return button
end

function Library:CreateLib(title, themeName)
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")

    local old = playerGui:FindFirstChild("UsureLibrary")
    if old then
        old:Destroy()
    end

    local gui = New("ScreenGui", {
        Name = "UsureLibrary",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, playerGui)

    local window = New("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(845, 435),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, gui)

    Round(window, 12)
    Border(window)

    local topbar = New("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = T.Header,
        BorderSizePixel = 0
    }, window)

    local logo = Label(topbar, "◉", 21, T.Text, Enum.Font.GothamMedium)
    logo.Position = UDim2.fromOffset(15, 0)
    logo.Size = UDim2.fromOffset(26, 50)
    logo.TextXAlignment = Enum.TextXAlignment.Center

    local titleLabel = Label(topbar, title or "Usure", 16, T.Text, Enum.Font.GothamSemibold)
    titleLabel.Position = UDim2.fromOffset(43, 0)
    titleLabel.Size = UDim2.new(1, -130, 1, 0)

    local minimize = New("TextButton", {
        Position = UDim2.new(1, -80, 0, 0),
        Size = UDim2.fromOffset(25, 49),
        BackgroundTransparency = 1,
        Text = "—",
        TextColor3 = T.Muted,
        TextSize = 15,
        Font = Enum.Font.Gotham
    }, topbar)

    local maximize = New("TextButton", {
        Position = UDim2.new(1, -53, 0, 0),
        Size = UDim2.fromOffset(25, 49),
        BackgroundTransparency = 1,
        Text = "□",
        TextColor3 = T.Muted,
        TextSize = 13,
        Font = Enum.Font.Gotham
    }, topbar)

    local close = New("TextButton", {
        Position = UDim2.new(1, -28, 0, 0),
        Size = UDim2.fromOffset(25, 49),
        BackgroundTransparency = 1,
        Text = "×",
        TextColor3 = T.Muted,
        TextSize = 15,
        Font = Enum.Font.Gotham
    }, topbar)

    New("Frame", {
        Position = UDim2.new(0, 0, 1, -1),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = T.Border,
        BorderSizePixel = 0
    }, topbar)

    local sidebar = New("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, 50),
        Size = UDim2.new(0, 166, 1, -50),
        BackgroundColor3 = T.Sidebar,
        BorderSizePixel = 0
    }, window)

    New("Frame", {
        Position = UDim2.new(1, -1, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = T.Border,
        BorderSizePixel = 0
    }, sidebar)

    local tabList = New("ScrollingFrame", {
        Name = "TabList",
        Position = UDim2.fromOffset(0, 10),
        Size = UDim2.new(1, -1, 1, -20),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = T.Muted,
        CanvasSize = UDim2.new()
    }, sidebar)

    AddPadding(tabList, 0, 0, 0, 0)
    local tabLayout = AddList(tabList, 3)

    local content = New("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(166, 50),
        Size = UDim2.new(1, -166, 1, -50),
        BackgroundColor3 = T.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, window)

    local pages = New("Folder", {
        Name = "Pages"
    }, content)

    local self = setmetatable({
        Gui = gui,
        Window = window,
        Tabs = {},
        SelectedTab = nil,
        TabCount = 0
    }, Library)

    local function SelectTab(tab)
        self.SelectedTab = tab

        for _, other in ipairs(self.Tabs) do
            local selected = other == tab
            other.Page.Visible = selected
            other.Indicator.Visible = selected
            other.Button.BackgroundColor3 = selected and T.Selected or T.Sidebar
            other.Button.TextColor3 = selected and T.Text or T.Muted
        end
    end

    function self:NewTab(tabName)
        self.TabCount += 1

        local tabButton = New("TextButton", {
            Name = tostring(tabName),
            Size = UDim2.new(1, 0, 0, 39),
            BackgroundColor3 = T.Sidebar,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "   " .. tostring(tabName),
            TextColor3 = T.Muted,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = self.TabCount
        }, tabList)

        local indicator = New("Frame", {
            Position = UDim2.fromOffset(0, 4),
            Size = UDim2.new(0, 2, 1, -8),
            BackgroundColor3 = T.Accent,
            BorderSizePixel = 0,
            Visible = false
        }, tabButton)

        local page = New("ScrollingFrame", {
            Name = tostring(tabName) .. "Page",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = T.Muted,
            CanvasSize = UDim2.new(),
            Visible = false
        }, pages)

        AddPadding(page, 14, 14, 15, 15)
        local pageLayout = AddList(page, 13)

        local function updatePage()
            page.CanvasSize = UDim2.fromOffset(
                0,
                pageLayout.AbsoluteContentSize.Y + 30
            )
        end

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updatePage)

        local tab = {
            Name = tabName,
            Button = tabButton,
            Indicator = indicator,
            Page = page,
            Sections = {}
        }

        function tab:NewSection(sectionName)
            local sectionFrame = New("Frame", {
                Name = tostring(sectionName),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                BorderSizePixel = 0
            }, page)

            local heading = Label(sectionFrame, sectionName, 18, T.Text, Enum.Font.GothamMedium)
            heading.Size = UDim2.new(1, 0, 0, 27)

            local elements = New("Frame", {
                Position = UDim2.fromOffset(0, 31),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                BorderSizePixel = 0
            }, sectionFrame)

            local elementLayout = AddList(elements, 6)

            elementLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                elements.Size = UDim2.new(
                    1, 0, 0, elementLayout.AbsoluteContentSize.Y
                )
                updatePage()
            end)

            local section = {
                Frame = sectionFrame,
                Elements = elements,
                Tab = self
            }

            function section:NewButton(name, description, callback)
                if type(description) == "function" then
                    callback = description
                end

                local button = ElementButton(elements, name)

                button.MouseButton1Click:Connect(function()
                    if type(callback) == "function" then
                        task.spawn(callback)
                    end
                end)

                return button
            end

            function section:NewToggle(name, description, callback)
                if type(description) == "function" then
                    callback = description
                end

                local state = false

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0
                }, elements)

                Round(row, 5)
                Border(row)

                local text = Label(row, name, 13, T.Text)
                text.Position = UDim2.fromOffset(11, 0)
                text.Size = UDim2.new(1, -65, 1, 0)

                local switch = New("TextButton", {
                    Position = UDim2.new(1, -45, 0.5, -9),
                    Size = UDim2.fromOffset(34, 18),
                    BackgroundColor3 = T.Hover,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                }, row)

                Round(switch, 9)

                local knob = New("Frame", {
                    Position = UDim2.fromOffset(2, 2),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundColor3 = T.Muted,
                    BorderSizePixel = 0
                }, switch)

                Round(knob, 8)

                local function setState(value)
                    state = value == true
                    switch.BackgroundColor3 = state and T.Accent or T.Hover
                    knob.BackgroundColor3 = state and T.Background or T.Muted
                    knob.Position = state
                        and UDim2.new(1, -16, 0, 2)
                        or UDim2.fromOffset(2, 2)

                    if type(callback) == "function" then
                        task.spawn(callback, state)
                    end
                end

                switch.MouseButton1Click:Connect(function()
                    setState(not state)
                end)

                local result = {}

                function result:Set(value)
                    setState(value)
                end

                function result:Get()
                    return state
                end

                return result
            end

            function section:NewSlider(name, description, minValue, maxValue, defaultValue, callback)
                if type(description) ~= "string" then
                    callback = defaultValue
                    defaultValue = maxValue
                    maxValue = minValue
                    minValue = description
                end

                minValue = tonumber(minValue) or 0
                maxValue = tonumber(maxValue) or 100
                defaultValue = math.clamp(
                    tonumber(defaultValue) or minValue,
                    minValue,
                    maxValue
                )

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 59),
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0
                }, elements)

                Round(row, 5)
                Border(row)

                local text = Label(row, name, 13, T.Text)
                text.Position = UDim2.fromOffset(11, 3)
                text.Size = UDim2.new(1, -80, 0, 24)

                local valueLabel = Label(row, defaultValue, 12, T.Muted)
                valueLabel.Position = UDim2.new(1, -65, 0, 3)
                valueLabel.Size = UDim2.fromOffset(53, 24)
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right

                local bar = New("TextButton", {
                    Position = UDim2.new(0, 11, 0, 37),
                    Size = UDim2.new(1, -22, 0, 4),
                    BackgroundColor3 = T.Hover,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false
                }, row)

                Round(bar, 4)

                local fill = New("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = T.Accent,
                    BorderSizePixel = 0
                }, bar)

                Round(fill, 4)

                local knob = New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.fromOffset(10, 10),
                    BackgroundColor3 = T.Text,
                    BorderSizePixel = 0
                }, bar)

                Round(knob, 6)

                local value = defaultValue
                local sliding = false

                local function setValue(newValue, call)
                    value = math.clamp(
                        math.floor(newValue + 0.5),
                        minValue,
                        maxValue
                    )

                    local alpha = (value - minValue)
                        / math.max(maxValue - minValue, 1)

                    fill.Size = UDim2.new(alpha, 0, 1, 0)
                    knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                    valueLabel.Text = tostring(value)

                    if call and type(callback) == "function" then
                        task.spawn(callback, value)
                    end
                end

                local function update(inputObject)
                    local width = math.max(bar.AbsoluteSize.X, 1)
                    local alpha = math.clamp(
                        (inputObject.Position.X - bar.AbsolutePosition.X) / width,
                        0, 1
                    )

                    setValue(minValue + (maxValue - minValue) * alpha, true)
                end

                bar.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                        or inputObject.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        update(inputObject)
                    end
                end)

                local changed = UIS.InputChanged:Connect(function(inputObject)
                    if sliding and (
                        inputObject.UserInputType == Enum.UserInputType.MouseMovement
                        or inputObject.UserInputType == Enum.UserInputType.Touch
                    ) then
                        update(inputObject)
                    end
                end)

                local ended = UIS.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                        or inputObject.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)

                local result = {}

                function result:Set(newValue)
                    setValue(newValue, true)
                end

                function result:Get()
                    return value
                end

                function result:Destroy()
                    changed:Disconnect()
                    ended:Disconnect()
                    row:Destroy()
                end

                setValue(defaultValue, false)
                return result
            end

            function section:NewTextBox(name, description, callback)
                if type(description) == "function" then
                    callback = description
                end

                local row = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0
                }, elements)

                Round(row, 5)
                Border(row)

                local box = New("TextBox", {
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(1, -22, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    PlaceholderText = tostring(name),
                    PlaceholderColor3 = T.Muted,
                    TextColor3 = T.Text,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, row)

                box.FocusLost:Connect(function(enterPressed)
                    if type(callback) == "function" then
                        task.spawn(callback, box.Text, enterPressed)
                    end
                end)

                return box
            end

            function section:NewLabel(text)
                local label = Label(elements, text, 13, T.Muted)
                label.Size = UDim2.new(1, 0, 0, 25)
                return label
            end

            function section:NewDropdown(name, description, options, callback)
                if type(description) ~= "string" then
                    callback = options
                    options = description
                end

                options = options or {}

                local button = ElementButton(elements, tostring(name) .. "  ▾")

                local listFrame = New("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = T.Element,
                    BorderSizePixel = 0,
                    Visible = false
                }, elements)

                Round(listFrame, 5)
                Border(listFrame)
                AddPadding(listFrame, 5, 5, 5, 5)
                local listLayout = AddList(listFrame, 4)

                local selected

                local function rebuild()
                    for _, child in ipairs(listFrame:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end

                    for _, option in ipairs(options) do
                        local optionButton = ElementButton(listFrame, option)
                        optionButton.Size = UDim2.new(1, 0, 0, 30)

                        optionButton.MouseButton1Click:Connect(function()
                            selected = option
                            button.Text = tostring(name) .. "  ▾  " .. tostring(option)
                            listFrame.Visible = false

                            if type(callback) == "function" then
                                task.spawn(callback, option)
                            end
                        end)
                    end
                end

                listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    listFrame.Size = UDim2.new(
                        1, 0, 0, listLayout.AbsoluteContentSize.Y + 10
                    )
                end)

                rebuild()

                button.MouseButton1Click:Connect(function()
                    listFrame.Visible = not listFrame.Visible
                end)

                local result = {}

                function result:SetOptions(newOptions)
                    options = newOptions or {}
                    selected = nil
                    rebuild()
                end

                function result:Get()
                    return selected
                end

                return result
            end

            return section
        end

        tabButton.MouseButton1Click:Connect(function()
            SelectTab(tab)
        end)

        table.insert(self.Tabs, tab)

        if #self.Tabs == 1 then
            SelectTab(tab)
        end

        tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabList.CanvasSize = UDim2.fromOffset(
                0,
                tabLayout.AbsoluteContentSize.Y + 10
            )
        end)

        return tab
    end

    function self:SetVisible(value)
        window.Visible = value == true
    end

    function self:SetTitle(value)
        titleLabel.Text = tostring(value)
    end

    function self:Destroy()
        gui:Destroy()
    end

    close.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    local minimized = false
    local maximized = false
    local normalSize = UDim2.fromOffset(845, 435)

    minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        sidebar.Visible = not minimized
        content.Visible = not minimized
        window.Size = minimized and UDim2.fromOffset(845, 50) or normalSize
        maximize.Visible = not minimized
    end)

    maximize.MouseButton1Click:Connect(function()
        maximized = not maximized

        if maximized then
            window.Size = UDim2.new(1, -30, 1, -30)
            window.Position = UDim2.fromScale(0.5, 0.5)
        else
            window.Size = normalSize
            window.Position = UDim2.fromScale(0.5, 0.5)
        end
    end)

    local dragging = false
    local dragStart
    local startPosition

    topbar.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = inputObject.Position
            startPosition = window.Position
        end
    end)

    UIS.InputChanged:Connect(function(inputObject)
        if dragging and inputObject.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = inputObject.Position - dragStart

            window.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UIS.InputBegan:Connect(function(inputObject, processed)
        if not processed and inputObject.KeyCode == Enum.KeyCode.RightControl then
            if gui.Parent then
                window.Visible = not window.Visible
            end
        end
    end)

    return self
end

return Library
