
local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local C = {
    bg = Color3.fromRGB(5, 6, 8),
    panel = Color3.fromRGB(9, 10, 12),
    card = Color3.fromRGB(10, 11, 13),
    item = Color3.fromRGB(14, 15, 18),
    hover = Color3.fromRGB(24, 25, 29),
    border = Color3.fromRGB(34, 36, 41),
    text = Color3.fromRGB(239, 240, 243),
    muted = Color3.fromRGB(132, 135, 143),
    accent = Color3.fromRGB(230, 235, 242),
    active = Color3.fromRGB(45, 47, 53)
}

local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    make("UICorner", {
        CornerRadius = UDim.new(0, radius or 5)
    }, obj)
end

local function stroke(obj, color, thickness)
    return make("UIStroke", {
        Color = color or C.border,
        Thickness = thickness or 1
    }, obj)
end

local function label(parent, text, size, color, font)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextColor3 = color or C.text,
        TextSize = size or 11,
        Font = font or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function button(parent, text, size)
    return make("TextButton", {
        Size = size or UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = C.item,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = text or "",
        TextColor3 = C.text,
        TextSize = 10,
        Font = Enum.Font.GothamMedium
    }, parent)
end

function Library:CreateLib(title)
    local player = Players.LocalPlayer
    local gui = make("ScreenGui", {
        Name = "CustomExecutorUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, player:WaitForChild("PlayerGui"))

    local self = setmetatable({
        Gui = gui,
        Categories = {},
        Connections = {},
        Cleanups = {},
        Destroyed = false,
        SearchText = "",
        NextOrder = 0,
        AccentColor = C.accent
    }, Library)

    function self:Track(connection)
        table.insert(self.Connections, connection)
        return connection
    end

    function self:BindConnection(connection)
        return self:Track(connection)
    end

    function self:BindCleanup(callback)
        if type(callback) == "function" then
            table.insert(self.Cleanups, callback)
        end
        return callback
    end

    local window = make("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(0.98, 0, 0.98, 0),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, gui)
    corner(window, 9)
    stroke(window, C.border)

    local top = make("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0
    }, window)

    local logo = make("Frame", {
        Position = UDim2.fromOffset(12, 10),
        Size = UDim2.fromOffset(36, 31),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0
    }, top)
    corner(logo, 6)
    stroke(logo)

    local logoText = label(logo, "U", 15, C.text, Enum.Font.GothamBold)
    logoText.Size = UDim2.fromScale(1, 1)
    logoText.TextXAlignment = Enum.TextXAlignment.Center

    local titleText = label(top, title or "Executor", 13, C.text, Enum.Font.GothamBold)
    titleText.Position = UDim2.fromOffset(60, 0)
    titleText.Size = UDim2.new(1, -180, 1, 0)

    local status = label(top, "ONLINE", 8, C.muted, Enum.Font.GothamBold)
    status.AnchorPoint = Vector2.new(1, 0)
    status.Position = UDim2.new(1, -60, 0, 0)
    status.Size = UDim2.fromOffset(55, 50)
    status.TextXAlignment = Enum.TextXAlignment.Right

    local close = button(top, "×", UDim2.fromOffset(35, 34))
    close.Position = UDim2.new(1, -45, 0, 8)
    close.BackgroundColor3 = C.item
    corner(close, 5)

    local searchBar = make("Frame", {
        Name = "SearchArea",
        Position = UDim2.fromOffset(8, 57),
        Size = UDim2.new(1, -16, 0, 42),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0
    }, window)
    corner(searchBar, 6)
    stroke(searchBar)

    local search = make("TextBox", {
        Name = "Search",
        Position = UDim2.fromOffset(7, 5),
        Size = UDim2.new(1, -220, 1, -10),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Text = "",
        PlaceholderText = "SEARCH FUNCTIONS...",
        PlaceholderColor3 = C.muted,
        TextColor3 = C.text,
        TextSize = 9,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, searchBar)
    corner(search, 5)
    stroke(search)

    local function searchButton(text, width)
        local b = button(searchBar, text, UDim2.fromOffset(width, 29))
        b.AnchorPoint = Vector2.new(1, 0.5)
        b.Position = UDim2.new(1, 0, 0.5, 0)
        b.BackgroundColor3 = C.bg
        corner(b, 5)
        stroke(b)
        return b
    end

    local topButton = searchButton("TOP", 57)
    topButton.Position = UDim2.new(1, -5, 0.5, 0)

    local collapseButton = searchButton("COLLAPSE", 62)
    collapseButton.Position = UDim2.new(1, -67, 0.5, 0)

    local expandButton = searchButton("EXPAND", 60)
    expandButton.Position = UDim2.new(1, -133, 0.5, 0)

    local grid = make("ScrollingFrame", {
        Name = "CategoryGrid",
        Position = UDim2.fromOffset(8, 105),
        Size = UDim2.new(1, -16, 1, -113),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = C.border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.None
    }, window)

    local gridLayout = make("UIGridLayout", {
        CellPadding = UDim2.fromOffset(9, 8),
        CellSize = UDim2.new(1 / 3, -8, 0, 290),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top
    }, grid)

    local resize = button(window, "◢", UDim2.fromOffset(20, 20))
    resize.Name = "Resize"
    resize.AnchorPoint = Vector2.new(1, 1)
    resize.Position = UDim2.new(1, -2, 1, -2)
    resize.BackgroundColor3 = C.bg
    resize.TextColor3 = C.muted
    resize.ZIndex = 10

    local floating = button(gui, "U", UDim2.fromOffset(43, 43))
    floating.Name = "FloatingIcon"
    floating.Position = UDim2.new(1, -58, 0.5, 0)
    floating.AnchorPoint = Vector2.new(0.5, 0.5)
    floating.TextSize = 17
    floating.Font = Enum.Font.GothamBold
    floating.BackgroundColor3 = C.panel
    floating.Visible = false
    floating.ZIndex = 20
    corner(floating, 9)
    stroke(floating, C.accent, 1)

    local savedWindowPosition = window.Position
    local savedWindowSize = window.Size
    local savedFloatingPosition = floating.Position
    local minimized = false
    local collapsed = false
    local dragState = nil
    local resizing = false
    local resizeOrigin
    local resizeSize

    local function updateGrid()
        local width = grid.AbsoluteSize.X
        local columns = width >= 950 and 3 or (width >= 580 and 2 or 1)
        local padding = 9
        local cellWidth = math.floor((width - padding * (columns - 1)) / columns)

        gridLayout.CellSize = UDim2.fromOffset(cellWidth, 290)
        gridLayout.CellPadding = UDim2.fromOffset(padding, 8)

        local rows = math.ceil(#self.Categories / columns)
        local visibleRows = 0

        for _, category in ipairs(self.Categories) do
            if category.Frame.Visible then
                visibleRows += 1
            end
        end

        grid.CanvasSize = UDim2.fromOffset(
            0,
            math.ceil(visibleRows / columns) * 298 + 8
        )
    end

    local function refreshSearch()
        local query = string.lower(self.SearchText)

        for _, category in ipairs(self.Categories) do
            local anyVisible = false

            for _, item in ipairs(category.Items) do
                local match = query == ""
                    or string.find(string.lower(item.Name), query, 1, true) ~= nil

                item.Frame.Visible = match
                if match then
                    anyVisible = true
                end
            end

            category.Frame.Visible = query == "" or anyVisible
        end

        updateGrid()
    end

    self:Track(search:GetPropertyChangedSignal("Text"):Connect(function()
        self.SearchText = search.Text
        refreshSearch()
    end))

    local function reorder()
        table.sort(self.Categories, function(a, b)
            if a.Order == b.Order then
                return a.Id < b.Id
            end
            return a.Order < b.Order
        end)

        for index, category in ipairs(self.Categories) do
            category.Frame.LayoutOrder = index
        end

        updateGrid()
    end

    function self:NewCategory(name, order)
        if self.Destroyed then
            return
        end

        self.NextOrder += 1

        local frame = make("Frame", {
            Name = tostring(name),
            BackgroundColor3 = C.card,
            BorderSizePixel = 0,
            LayoutOrder = tonumber(order) or self.NextOrder,
            ClipsDescendants = true
        }, grid)
        corner(frame, 6)
        stroke(frame)

        local header = button(frame, "", UDim2.new(1, -8, 0, 31))
        header.Parent = frame
        header.Position = UDim2.fromOffset(4, 4)
        header.BackgroundColor3 = C.panel
        header.Text = ""
        corner(header, 4)
        stroke(header)

        local headerText = label(header, string.upper(name), 9, C.text, Enum.Font.GothamBold)
        headerText.Position = UDim2.fromOffset(8, 0)
        headerText.Size = UDim2.new(1, -30, 1, 0)

        local arrow = label(header, "−", 13, C.muted)
        arrow.AnchorPoint = Vector2.new(1, 0)
        arrow.Position = UDim2.new(1, -9, 0, 0)
        arrow.Size = UDim2.fromOffset(15, 31)
        arrow.TextXAlignment = Enum.TextXAlignment.Center

        local content = make("ScrollingFrame", {
            Name = "Items",
            Position = UDim2.fromOffset(5, 41),
            Size = UDim2.new(1, -10, 1, -46),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = C.border,
            CanvasSize = UDim2.new()
        }, frame)

        local contentLayout = make("UIListLayout", {
            Padding = UDim.new(0, 5),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, content)

        local category = {
            Id = self.NextOrder,
            Name = tostring(name),
            Order = tonumber(order) or self.NextOrder,
            Frame = frame,
            Header = header,
            Content = content,
            Items = {},
            Collapsed = false
        }

        local function updateContent()
            content.CanvasSize = UDim2.fromOffset(
                0,
                contentLayout.AbsoluteContentSize.Y + 6
            )
        end

        self:Track(contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateContent))

        local function makeItem(itemName, height)
            local row = make("Frame", {
                Name = itemName,
                Size = UDim2.new(1, -2, 0, height or 32),
                BackgroundColor3 = C.item,
                BorderSizePixel = 0
            }, content)
            corner(row, 5)
            stroke(row)

            local item = {
                Name = tostring(itemName),
                Frame = row
            }

            table.insert(category.Items, item)
            refreshSearch()
            return row, item
        end

        local function makeToggle(name, description, callback)
            if type(description) == "function" then
                callback = description
            end

            local row, item = makeItem(name, 32)

            local text = label(row, name, 10, C.text)
            text.Position = UDim2.fromOffset(11, 0)
            text.Size = UDim2.new(1, -65, 1, 0)

            local switch = make("TextButton", {
                Position = UDim2.new(1, -49, 0.5, -9),
                Size = UDim2.fromOffset(39, 18),
                BackgroundColor3 = C.hover,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, row)
            corner(switch, 9)

            local knob = make("Frame", {
                Position = UDim2.fromOffset(3, 3),
                Size = UDim2.fromOffset(12, 12),
                BackgroundColor3 = C.text,
                BorderSizePixel = 0
            }, switch)
            corner(knob, 8)

            local enabled = false
            local toggle = {}

            function toggle:Set(value, silent)
                enabled = value == true
                switch.BackgroundColor3 = enabled and C.active or C.hover
                knob.Position = enabled
                    and UDim2.new(1, -15, 0, 3)
                    or UDim2.fromOffset(3, 3)

                if not silent and type(callback) == "function" then
                    task.spawn(callback, enabled)
                end
            end

            function toggle:Get()
                return enabled
            end

            switch.MouseButton1Click:Connect(function()
                toggle:Set(not enabled)
            end)

            table.insert(self.Toggles or {}, toggle)
            item.Toggle = toggle
            return toggle
        end

        local function makeButton(name, description, callback)
            if type(description) == "function" then
                callback = description
            end

            local row, item = makeItem(name, 32)

            local b = button(row, name, UDim2.new(1, 0, 1, 0))
            b.Position = UDim2.fromOffset(0, 0)
            b.BackgroundTransparency = 1
            b.TextSize = 10
            corner(b, 5)

            b.MouseEnter:Connect(function()
                row.BackgroundColor3 = C.hover
            end)

            b.MouseLeave:Connect(function()
                row.BackgroundColor3 = C.item
            end)

            b.MouseButton1Click:Connect(function()
                if not self.Destroyed and type(callback) == "function" then
                    task.spawn(callback)
                end
            end)

            item.Button = b
            return b
        end

        local function makeSlider(name, description, minValue, maxValue, defaultValue, callback)
            if type(description) ~= "string" then
                callback = defaultValue
                defaultValue = maxValue
                maxValue = minValue
                minValue = description
            end

            minValue = tonumber(minValue) or 0
            maxValue = tonumber(maxValue) or 100
            defaultValue = math.clamp(
                tonumber(defaultValue) or minValue,
                minValue,
                maxValue
            )

            local row, item = makeItem(name, 55)

            local text = label(row, name, 10, C.text)
            text.Position = UDim2.fromOffset(11, 2)
            text.Size = UDim2.new(1, -50, 0, 20)

            local valueLabel = label(row, defaultValue, 10, C.text)
            valueLabel.Position = UDim2.new(1, -42, 0, 2)
            valueLabel.Size = UDim2.fromOffset(30, 20)
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local bar = make("TextButton", {
                Position = UDim2.new(0, 11, 0, 36),
                Size = UDim2.new(1, -22, 0, 4),
                BackgroundColor3 = C.hover,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false
            }, row)
            corner(bar, 3)

            local fill = make("Frame", {
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundColor3 = C.text,
                BorderSizePixel = 0
            }, bar)
            corner(fill, 3)

            local value = defaultValue
            local dragging = false

            local function setValue(v, fire)
                value = math.clamp(
                    math.floor(v + 0.5),
                    minValue,
                    maxValue
                )

                local alpha = (value - minValue) / math.max(maxValue - minValue, 1)
                fill.Size = UDim2.new(alpha, 0, 1, 0)
                valueLabel.Text = tostring(value)

                if fire and type(callback) == "function" then
                    task.spawn(callback, value)
                end
            end

            local function update(input)
                local alpha = math.clamp(
                    (input.Position.X - bar.AbsolutePosition.X)
                        / math.max(bar.AbsoluteSize.X, 1),
                    0,
                    1
                )
                setValue(minValue + (maxValue - minValue) * alpha, true)
            end

            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    update(input)
                end
            end)

            self:Track(UIS.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch
                ) then
                    update(input)
                end
            end))

            self:Track(UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end))

            local slider = {}

            function slider:Set(v)
                setValue(v, true)
            end

            function slider:Get()
                return value
            end

            setValue(defaultValue, false)
            item.Slider = slider
            return slider
        end

        local function makeLabel(text)
            local row, item = makeItem(text, 25)
            row.BackgroundTransparency = 1

            local textLabel = label(row, text, 10, C.muted)
            textLabel.Size = UDim2.fromScale(1, 1)

            return textLabel
        end

        function category:NewButton(name, description, callback)
            return makeButton(name, description, callback)
        end

        function category:NewToggle(name, description, callback)
            return makeToggle(name, description, callback)
        end

        function category:NewSlider(name, description, minValue, maxValue, defaultValue, callback)
            return makeSlider(name, description, minValue, maxValue, defaultValue, callback)
        end

        function category:NewLabel(text)
            return makeLabel(text)
        end

        function category:SetOrder(newOrder)
            category.Order = tonumber(newOrder) or category.Order
            reorder()
        end

        function category:SetCollapsed(value)
            category.Collapsed = value == true
            content.Visible = not category.Collapsed
            arrow.Text = category.Collapsed and "+" or "−"
            updateGrid()
        end

        header.MouseButton1Click:Connect(function()
            category:SetCollapsed(not category.Collapsed)
        end)

        local draggingCategory = false
        local dragStart
        local moved = false

        header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingCategory = true
                dragStart = input.Position
                moved = false
            end
        end)

        self:Track(UIS.InputChanged:Connect(function(input)
            if not draggingCategory or input.UserInputType ~= Enum.UserInputType.MouseMovement then
                return
            end

            if (input.Position - dragStart).Magnitude > 12 then
                moved = true
            end
        end))

        self:Track(UIS.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not draggingCategory then
                return
            end

            draggingCategory = false

            if moved then
                local center = category.Frame.AbsolutePosition
                    + category.Frame.AbsoluteSize / 2

                local nearest
                local nearestDistance = math.huge

                for _, other in ipairs(self.Categories) do
                    if other ~= category and other.Frame.Visible then
                        local otherCenter = other.Frame.AbsolutePosition
                            + other.Frame.AbsoluteSize / 2

                        local distance = (center - otherCenter).Magnitude
                        if distance < nearestDistance then
                            nearestDistance = distance
                            nearest = other
                        end
                    end
                end

                if nearest then
                    local oldOrder = category.Order
                    category.Order = nearest.Order
                    nearest.Order = oldOrder
                    reorder()
                end
            end
        end))

        table.insert(self.Categories, category)
        reorder()
        return category
    end

    function self:SetCategoryOrder(names)
        for order, name in ipairs(names) do
            for _, category in ipairs(self.Categories) do
                if string.lower(category.Name) == string.lower(name) then
                    category.Order = order
                end
            end
        end
        reorder()
    end

    local function setCollapsedAll(value)
        for _, category in ipairs(self.Categories) do
            category:SetCollapsed(value)
        end
    end

    collapseButton.MouseButton1Click:Connect(function()
        setCollapsedAll(true)
    end)

    expandButton.MouseButton1Click:Connect(function()
        setCollapsedAll(false)
    end)

    topButton.MouseButton1Click:Connect(function()
        grid.CanvasPosition = Vector2.zero
    end)

    local function hideWindow()
        if self.Destroyed or minimized then
            return
        end

        savedWindowPosition = window.Position
        savedWindowSize = window.Size
        minimized = true
        window.Visible = false
        floating.Position = savedFloatingPosition
        floating.Visible = true
    end

    local function showWindow()
        minimized = false
        floating.Visible = false
        window.Visible = true
        window.Position = savedWindowPosition
        window.Size = savedWindowSize
    end

    floating.MouseButton1Click:Connect(showWindow)

    close.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    self:Track(UIS.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.LeftAlt then
            if minimized then
                showWindow()
            else
                hideWindow()
            end
        end
    end))

    local function beginDrag(object, input)
        dragState = {
            Object = object,
            Start = input.Position,
            Position = object.Position
        }
    end

    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            beginDrag(window, input)
        end
    end)

    floating.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            beginDrag(floating, input)
        end
    end)

    self:Track(UIS.InputChanged:Connect(function(input)
        if dragState and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragState.Start
            local object = dragState.Object
            object.Position = UDim2.new(
                dragState.Position.X.Scale,
                dragState.Position.X.Offset + delta.X,
                dragState.Position.Y.Scale,
                dragState.Position.Y.Offset + delta.Y
            )
        end

        if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - resizeOrigin
            local width = math.clamp(resizeSize.X + delta.X, 600, 1600)
            local height = math.clamp(resizeSize.Y + delta.Y, 400, 1100)
            window.Size = UDim2.fromOffset(width, height)
            savedWindowSize = window.Size
            updateGrid()
        end
    end))

    self:Track(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragState then
                if dragState.Object == window then
                    savedWindowPosition = window.Position
                elseif dragState.Object == floating then
                    savedFloatingPosition = floating.Position
                end
                dragState = nil
            end

            resizing = false
        end
    end))

    resize.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            resizeOrigin = input.Position
            resizeSize = window.AbsoluteSize
        end
    end)

    function self:Destroy()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        for _, toggle in ipairs(self.Toggles or {}) do
            pcall(function()
                toggle:Set(false)
            end)
        end

        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        for _, cleanup in ipairs(self.Cleanups) do
            pcall(cleanup)
        end

        table.clear(self.Connections)
        table.clear(self.Cleanups)
        gui:Destroy()
    end

    self:Track(grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateGrid))

    return self
end

return Library
